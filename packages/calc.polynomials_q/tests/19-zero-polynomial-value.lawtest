language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Отдельным правилом, потому что степени у него нет и свёртке не с чего начаться.

test "нулевой многочлен принимает ноль в любой точке" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 0 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": evaluation_request(entity_ref("urn:calc:pq:f"), 5 / 1) { origin case_input; }
 }
 evaluate truth(poly_value(entity_ref("urn:calc:pq:f"), 5 / 1, 0 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(PolyValueZero);
}
