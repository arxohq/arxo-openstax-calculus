language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// (x³ − 2x² + 3) ÷ (1/6 x² + 1/3 x + 1/2): частное и остаток точны, приведения делителя не требуется.

test "деление на многочлен с дробным старшим коэффициентом" {
 given {
  assert "f0": degree_cap(12) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 3) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 3 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, -2 / 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:f"), 3, 1 / 1) { origin case_input; }
  assert "f6": poly(entity_ref("urn:calc:pq:g"), 2) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 0, 1 / 2) { origin case_input; }
  assert "f8": term(entity_ref("urn:calc:pq:g"), 1, 1 / 3) { origin case_input; }
  assert "f9": term(entity_ref("urn:calc:pq:g"), 2, 1 / 6) { origin case_input; }
  assert "f10": produced(entity_ref("urn:calc:pq:q"), 1) { origin case_input; }
  assert "f11": produced(entity_ref("urn:calc:pq:r"), 3) { origin case_input; }
  assert "f12": division(entity_ref("urn:calc:pq:dv"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f13": division_binding(entity_ref("urn:calc:pq:dv"), "QUOTIENT", entity_ref("urn:calc:pq:q")) { origin case_input; }
  assert "f14": division_binding(entity_ref("urn:calc:pq:dv"), "REMAINDER", entity_ref("urn:calc:pq:r")) { origin case_input; }
 }
 evaluate truth(coeff(entity_ref("urn:calc:pq:q"), 1, 6 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(coeff(entity_ref("urn:calc:pq:q"), 0, -24 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(coeff(entity_ref("urn:calc:pq:r"), 0, 15 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(remainder_smaller(entity_ref("urn:calc:pq:dv")));
 expect truth_status == TRUE_ONLY;
}
