language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Пропущенное место — неполный ввод, а не нулевой коэффициент.

test "неплотное предъявление отклонено" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 2, 1 / 1) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:f"), "INCOMPLETE_INPUT"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(IncompleteTerms);
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 2));
 expect truth_status == NEITHER;
}
