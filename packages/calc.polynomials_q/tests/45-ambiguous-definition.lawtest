language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Многочлен объявлен и предъявленным, и произведением: который из двух — вопрос без ответа.

test "два построения одного многочлена отклонены" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 1 / 1) { origin case_input; }
  assert "f4": poly(entity_ref("urn:calc:pq:g"), 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:g"), 0, -1 / 1) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:pq:g"), 1, 1 / 1) { origin case_input; }
  assert "f7": poly(entity_ref("urn:calc:pq:p"), 2) { origin case_input; }
  assert "f8": term(entity_ref("urn:calc:pq:p"), 0, 0 / 1) { origin case_input; }
  assert "f9": term(entity_ref("urn:calc:pq:p"), 1, 0 / 1) { origin case_input; }
  assert "f10": term(entity_ref("urn:calc:pq:p"), 2, 0 / 1) { origin case_input; }
  assert "f11": product_of(entity_ref("urn:calc:pq:p"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:p"), "AMBIGUOUS_DEFINITION"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(AmbiguousKind);
}
