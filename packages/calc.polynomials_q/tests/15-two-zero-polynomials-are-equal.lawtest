language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Степени нет ни у одного, и сравнение по степени не запускается: равенство выведено отдельным правилом.

test "два нулевых многочлена равны, хотя мест у них разное число" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 0 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
  assert "f5": poly(entity_ref("urn:calc:pq:g"), 0) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:pq:g"), 0, 0 / 1) { origin case_input; }
  assert "f7": claimed_identity("zeros", entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
 }
 evaluate truth(identity_holds("zeros"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(PolysEqualBothZero);
}
