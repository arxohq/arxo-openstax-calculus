language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Явно выбранная граница соглашения: приписать нулевому многочлену нулевую степень значило бы спутать его с константой, а «минус бесконечность» язык не знает. Поэтому `zero_polynomial` выводится, а `degree` — нет, и читатель обязан различать два ответа.

test "у нулевого многочлена степени НЕТ" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 0 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
 }
 evaluate truth(zero_polynomial(entity_ref("urn:calc:pq:f")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ZeroPolynomial);
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 0));
 expect truth_status == NEITHER;
}
