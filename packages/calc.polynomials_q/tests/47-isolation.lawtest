language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Дефект одного не заражает несвязанный соседний, и оба ответа даны в одном деле.

test "два многочлена в одном деле независимы" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 3) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, -1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:f"), 3, 1 / 1) { origin case_input; }
  assert "f6": poly(entity_ref("urn:calc:pq:bad"), 2) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:bad"), 0, 1 / 1) { origin case_input; }
 }
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 3));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(defect(entity_ref("urn:calc:pq:bad"), "INCOMPLETE_INPUT"));
 expect truth_status == TRUE_ONLY;
 evaluate truth(tainted(entity_ref("urn:calc:pq:f")));
 expect truth_status == NEITHER;
}
