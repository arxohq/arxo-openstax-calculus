language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Однозначность представления — часть контракта, а не предмет выбора «последнего».

test "два значения одного места отклонены" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 0, 5 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 1, 1 / 1) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:f"), "CONTRADICTORY_TERM"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ContradictoryTerm);
}
