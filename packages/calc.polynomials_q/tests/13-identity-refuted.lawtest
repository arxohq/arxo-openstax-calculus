language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// (x + 1)² ≠ x² + 1: расхождение в первом месте, и оно предъявлено.

test "ложное тождество опровергнуто с НАЗВАННЫМ местом" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 1 / 1) { origin case_input; }
  assert "f4": poly(entity_ref("urn:calc:pq:g"), 2) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:g"), 0, 1 / 1) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:pq:g"), 1, 0 / 1) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 2, 1 / 1) { origin case_input; }
  assert "f8": product_of(entity_ref("urn:calc:pq:sq"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:f")) { origin case_input; }
  assert "f9": claimed_identity("wrong", entity_ref("urn:calc:pq:sq"), entity_ref("urn:calc:pq:g")) { origin case_input; }
 }
 evaluate truth(coeff_mismatch(entity_ref("urn:calc:pq:sq"), entity_ref("urn:calc:pq:g"), 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(CoeffMismatch);
 evaluate truth(identity_holds("wrong"));
 expect truth_status == FALSE_ONLY;
 expect applied(IdentityNotBoth);
}
