language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Интеграл 2x от 1/2 до 3/2 равен 9/4 - 1/4 = 2. Пределы дробные, ответ точный: приближения нет нигде.

test "определённый интеграл с дробными пределами" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:ip"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:ip"), 0, 0 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:ip"), 1, 2 / 1) { origin case_input; }
  assert "f4": antiderivative_of(entity_ref("urn:calc:pq:iF"), entity_ref("urn:calc:pq:ip")) { origin case_input; }
  assert "f5": definite_integral_request(entity_ref("urn:calc:pq:ip"), entity_ref("urn:calc:pq:iF"), 1 / 2, 3 / 2) { origin case_input; }
 }
 evaluate truth(definite_integral(entity_ref("urn:calc:pq:ip"), 1 / 2, 3 / 2, 2 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(DefiniteIntegralValue);
}
