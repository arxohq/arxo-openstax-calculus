language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Ожидания: школьная арифметика над ℚ, DECISION-0197 §4.
test "значение дроби в рациональной точке" {
 given {
  assert "f0": degree_cap(12) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:limit:n"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:limit:n"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:limit:n"), 1, 1 / 1) { origin case_input; }
  assert "f4": poly(entity_ref("urn:calc:limit:d"), 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:limit:d"), 0, -1 / 1) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:limit:d"), 1, 1 / 1) { origin case_input; }
  assert "f7": rational_value_request(entity_ref("urn:calc:limit:n"), entity_ref("urn:calc:limit:d"), 3 / 2) { origin case_input; }
 }
 evaluate truth(rational_value(entity_ref("urn:calc:limit:n"), entity_ref("urn:calc:limit:d"), 3 / 2, 5 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
