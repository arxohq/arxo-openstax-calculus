language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// (1/6 x² + 1/3 x + 1/2) в точке −1/2 равно 3/8.

test "значение в дробной точке" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 2) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 1 / 3) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 1 / 6) { origin case_input; }
  assert "f5": evaluation_request(entity_ref("urn:calc:pq:f"), -1 / 2) { origin case_input; }
 }
 evaluate truth(poly_value(entity_ref("urn:calc:pq:f"), -1 / 2, 3 / 8));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
