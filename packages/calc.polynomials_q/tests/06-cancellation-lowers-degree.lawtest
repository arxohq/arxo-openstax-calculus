language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// (x² + 1) − (x² − 1) = 2: мест по-прежнему три, степень ноль.

test "сокращение старших членов ПОНИЖАЕТ степень, но не число мест" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 1 / 1) { origin case_input; }
  assert "f5": poly(entity_ref("urn:calc:pq:g"), 2) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:pq:g"), 0, -1 / 1) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 1, 0 / 1) { origin case_input; }
  assert "f8": term(entity_ref("urn:calc:pq:g"), 2, 1 / 1) { origin case_input; }
  assert "f9": difference_of(entity_ref("urn:calc:pq:d"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
 }
 evaluate truth(degree(entity_ref("urn:calc:pq:d"), 0));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(coeff(entity_ref("urn:calc:pq:d"), 0, 2 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(raw(entity_ref("urn:calc:pq:d"), 2, 0 / 1));
 expect truth_status == TRUE_ONLY;
}
