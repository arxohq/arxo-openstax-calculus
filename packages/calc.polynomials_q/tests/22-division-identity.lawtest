language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Обе части строятся ОБЩЕЙ арифметикой пакета: второй копии умножения у деления нет.

test "тождество f = q·g + r проверено пересчётом" {
 given {
  assert "f0": degree_cap(12) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 3) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 3 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, -2 / 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:f"), 3, 1 / 1) { origin case_input; }
  assert "f6": poly(entity_ref("urn:calc:pq:g"), 1) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 0, -1 / 1) { origin case_input; }
  assert "f8": term(entity_ref("urn:calc:pq:g"), 1, 1 / 1) { origin case_input; }
  assert "f9": produced(entity_ref("urn:calc:pq:q"), 2) { origin case_input; }
  assert "f10": produced(entity_ref("urn:calc:pq:r"), 3) { origin case_input; }
  assert "f11": division(entity_ref("urn:calc:pq:dv"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f12": division_binding(entity_ref("urn:calc:pq:dv"), "QUOTIENT", entity_ref("urn:calc:pq:q")) { origin case_input; }
  assert "f13": division_binding(entity_ref("urn:calc:pq:dv"), "REMAINDER", entity_ref("urn:calc:pq:r")) { origin case_input; }
  assert "f14": product_of(entity_ref("urn:calc:pq:qg"), entity_ref("urn:calc:pq:q"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f15": sum_of(entity_ref("urn:calc:pq:chk"), entity_ref("urn:calc:pq:qg"), entity_ref("urn:calc:pq:r")) { origin case_input; }
  assert "f16": claimed_identity("division", entity_ref("urn:calc:pq:chk"), entity_ref("urn:calc:pq:f")) { origin case_input; }
 }
 evaluate truth(identity_holds("division"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
