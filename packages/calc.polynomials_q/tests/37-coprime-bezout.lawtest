language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// u·f + v·g = 1 — то самое утверждение, ради которого расширенный алгоритм и нужен.

test "тождество Безу у взаимно простых" {
 given {
  assert "f0": degree_cap(16) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 1 / 1) { origin case_input; }
  assert "f5": poly(entity_ref("urn:calc:pq:g"), 1) { origin case_input; }
  assert "f6": term(entity_ref("urn:calc:pq:g"), 0, -1 / 1) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 1, 1 / 1) { origin case_input; }
  assert "f8": produced(entity_ref("urn:calc:pq:r2"), 2) { origin case_input; }
  assert "f9": produced(entity_ref("urn:calc:pq:r3"), 1) { origin case_input; }
  assert "f10": produced(entity_ref("urn:calc:pq:q1"), 1) { origin case_input; }
  assert "f11": produced(entity_ref("urn:calc:pq:q2"), 1) { origin case_input; }
  assert "f12": produced(entity_ref("urn:calc:pq:u0"), 0) { origin case_input; }
  assert "f13": produced(entity_ref("urn:calc:pq:u1"), 0) { origin case_input; }
  assert "f14": produced(entity_ref("urn:calc:pq:v0"), 0) { origin case_input; }
  assert "f15": produced(entity_ref("urn:calc:pq:v1"), 0) { origin case_input; }
  assert "f16": produced(entity_ref("urn:calc:pq:gcd"), 2) { origin case_input; }
  assert "f17": produced(entity_ref("urn:calc:pq:bu"), 1) { origin case_input; }
  assert "f18": produced(entity_ref("urn:calc:pq:bv"), 1) { origin case_input; }
  assert "f19": euclid(entity_ref("urn:calc:pq:ec"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f20": euclid_length(entity_ref("urn:calc:pq:ec"), 2) { origin case_input; }
  assert "f21": euclid_remainder(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:f")) { origin case_input; }
  assert "f22": euclid_remainder(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f23": euclid_remainder(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:r2")) { origin case_input; }
  assert "f24": euclid_remainder(entity_ref("urn:calc:pq:ec"), 3, entity_ref("urn:calc:pq:r3")) { origin case_input; }
  assert "f25": euclid_division(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:dv1")) { origin case_input; }
  assert "f26": division_binding(entity_ref("urn:calc:pq:dv1"), "QUOTIENT", entity_ref("urn:calc:pq:q1")) { origin case_input; }
  assert "f27": euclid_division(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:dv2")) { origin case_input; }
  assert "f28": division_binding(entity_ref("urn:calc:pq:dv2"), "QUOTIENT", entity_ref("urn:calc:pq:q2")) { origin case_input; }
  assert "f29": euclid_u(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:u0")) { origin case_input; }
  assert "f30": euclid_v(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:v0")) { origin case_input; }
  assert "f31": euclid_u(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:u1")) { origin case_input; }
  assert "f32": euclid_v(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:v1")) { origin case_input; }
  assert "f33": euclid_u(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:u2")) { origin case_input; }
  assert "f34": euclid_v(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:v2")) { origin case_input; }
  assert "f35": euclid_u(entity_ref("urn:calc:pq:ec"), 3, entity_ref("urn:calc:pq:u3")) { origin case_input; }
  assert "f36": euclid_v(entity_ref("urn:calc:pq:ec"), 3, entity_ref("urn:calc:pq:v3")) { origin case_input; }
  assert "f37": euclid_qu(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:qu1")) { origin case_input; }
  assert "f38": euclid_qv(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:qv1")) { origin case_input; }
  assert "f39": euclid_qu(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:qu2")) { origin case_input; }
  assert "f40": euclid_qv(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:qv2")) { origin case_input; }
  assert "f41": euclid_gcd(entity_ref("urn:calc:pq:ec"), entity_ref("urn:calc:pq:gcd")) { origin case_input; }
  assert "f42": euclid_bezout(entity_ref("urn:calc:pq:ec"), "U", entity_ref("urn:calc:pq:bu")) { origin case_input; }
  assert "f43": euclid_bezout(entity_ref("urn:calc:pq:ec"), "V", entity_ref("urn:calc:pq:bv")) { origin case_input; }
  assert "f44": product_of(entity_ref("urn:calc:pq:uf"), entity_ref("urn:calc:pq:bu"), entity_ref("urn:calc:pq:f")) { origin case_input; }
  assert "f45": product_of(entity_ref("urn:calc:pq:vg"), entity_ref("urn:calc:pq:bv"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f46": sum_of(entity_ref("urn:calc:pq:chk"), entity_ref("urn:calc:pq:uf"), entity_ref("urn:calc:pq:vg")) { origin case_input; }
  assert "f47": claimed_identity("bezout", entity_ref("urn:calc:pq:chk"), entity_ref("urn:calc:pq:gcd")) { origin case_input; }
 }
 evaluate truth(identity_holds("bezout"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
