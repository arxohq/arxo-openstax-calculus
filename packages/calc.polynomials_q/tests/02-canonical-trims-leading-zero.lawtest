language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Многочлен предъявлен как 0·x² + 2x + 1: мест три, степень одна, канонических коэффициентов два. `raw` по третьему месту есть, `coeff` — нет.

test "канон обрезает нулевое старшее место, а МЕСТА остаются" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 2 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
 }
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(TopZeroStep);
 evaluate truth(raw(entity_ref("urn:calc:pq:f"), 2, 0 / 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(coeff(entity_ref("urn:calc:pq:f"), 2, 0 / 1));
 expect truth_status == NEITHER;
}
