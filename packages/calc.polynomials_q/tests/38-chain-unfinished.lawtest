language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Один шаг вместо двух: последний остаток ненулевой. Это НЕЗАВЕРШЁННОСТЬ, а не отсутствие НОД: ни `gcd_index`, ни коэффициенты НОД не объявляются, и ответ «НОД равен x − 1» из недосчитанной цепочки не выдаётся.

test "объявленной длины цепочки не хватило" {
 given {
  assert "f0": degree_cap(14) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 3) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, -1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:f"), 3, 1 / 1) { origin case_input; }
  assert "f6": poly(entity_ref("urn:calc:pq:g"), 2) { origin case_input; }
  assert "f7": term(entity_ref("urn:calc:pq:g"), 0, -1 / 1) { origin case_input; }
  assert "f8": term(entity_ref("urn:calc:pq:g"), 1, 0 / 1) { origin case_input; }
  assert "f9": term(entity_ref("urn:calc:pq:g"), 2, 1 / 1) { origin case_input; }
  assert "f10": produced(entity_ref("urn:calc:pq:q1"), 1) { origin case_input; }
  assert "f11": produced(entity_ref("urn:calc:pq:r2"), 3) { origin case_input; }
  assert "f12": produced(entity_ref("urn:calc:pq:u0"), 0) { origin case_input; }
  assert "f13": produced(entity_ref("urn:calc:pq:u1"), 0) { origin case_input; }
  assert "f14": produced(entity_ref("urn:calc:pq:v0"), 0) { origin case_input; }
  assert "f15": produced(entity_ref("urn:calc:pq:v1"), 0) { origin case_input; }
  assert "f16": produced(entity_ref("urn:calc:pq:gcd"), 3) { origin case_input; }
  assert "f17": produced(entity_ref("urn:calc:pq:bu"), 1) { origin case_input; }
  assert "f18": produced(entity_ref("urn:calc:pq:bv"), 1) { origin case_input; }
  assert "f19": euclid(entity_ref("urn:calc:pq:ec"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f20": euclid_length(entity_ref("urn:calc:pq:ec"), 1) { origin case_input; }
  assert "f21": euclid_remainder(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:f")) { origin case_input; }
  assert "f22": euclid_remainder(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:g")) { origin case_input; }
  assert "f23": euclid_remainder(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:r2")) { origin case_input; }
  assert "f24": euclid_division(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:dv1")) { origin case_input; }
  assert "f25": division_binding(entity_ref("urn:calc:pq:dv1"), "QUOTIENT", entity_ref("urn:calc:pq:q1")) { origin case_input; }
  assert "f26": euclid_u(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:u0")) { origin case_input; }
  assert "f27": euclid_u(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:u1")) { origin case_input; }
  assert "f28": euclid_u(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:u2")) { origin case_input; }
  assert "f29": euclid_v(entity_ref("urn:calc:pq:ec"), 0, entity_ref("urn:calc:pq:v0")) { origin case_input; }
  assert "f30": euclid_v(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:v1")) { origin case_input; }
  assert "f31": euclid_v(entity_ref("urn:calc:pq:ec"), 2, entity_ref("urn:calc:pq:v2")) { origin case_input; }
  assert "f32": euclid_qu(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:qu1")) { origin case_input; }
  assert "f33": euclid_qv(entity_ref("urn:calc:pq:ec"), 1, entity_ref("urn:calc:pq:qv1")) { origin case_input; }
  assert "f34": euclid_gcd(entity_ref("urn:calc:pq:ec"), entity_ref("urn:calc:pq:gcd")) { origin case_input; }
  assert "f35": euclid_bezout(entity_ref("urn:calc:pq:ec"), "U", entity_ref("urn:calc:pq:bu")) { origin case_input; }
  assert "f36": euclid_bezout(entity_ref("urn:calc:pq:ec"), "V", entity_ref("urn:calc:pq:bv")) { origin case_input; }
 }
 evaluate truth(chain_unfinished(entity_ref("urn:calc:pq:ec")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ChainUnfinished);
 evaluate truth(chain_terminated(entity_ref("urn:calc:pq:ec")));
 expect truth_status == NEITHER;
 evaluate truth(gcd_index(entity_ref("urn:calc:pq:ec"), 2));
 expect truth_status == NEITHER;
 evaluate truth(coeff(entity_ref("urn:calc:pq:gcd"), 1, 1 / 1));
 expect truth_status == NEITHER;
}
