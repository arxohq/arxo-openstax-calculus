language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Лист моста: константа 1 читается одночленом нулевой степени.

test "мост читает константу" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:pq:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:pq:e1"), 2, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:pq:e1"), 3, "pow", "", 0 / 1, 1, 2) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:pq:e1"), 4, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "n5": calc.expressions::node(entity_ref("urn:calc:pq:e1"), 5, "add", "", 0 / 1, 3, 4) { origin case_input; }
  assert "n6": calc.expressions::closed(entity_ref("urn:calc:pq:e1")) { origin case_input; }
  assert "v": polynomial_variable(entity_ref("urn:calc:pq:e1"), "x") { origin case_input; }
  assert "p3": node_polynomial(entity_ref("urn:calc:pq:e1"), 3, entity_ref("urn:calc:pq:p3")) { origin case_input; }
  assert "p4": node_polynomial(entity_ref("urn:calc:pq:e1"), 4, entity_ref("urn:calc:pq:p4")) { origin case_input; }
  assert "p5": node_polynomial(entity_ref("urn:calc:pq:e1"), 5, entity_ref("urn:calc:pq:p5")) { origin case_input; }
 }
 evaluate truth(polynomial_of(entity_ref("urn:calc:pq:e1"), 4, "x", entity_ref("urn:calc:pq:p4")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(BridgeConstantRead);
}
