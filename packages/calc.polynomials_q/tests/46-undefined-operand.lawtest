language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Сомножитель, о котором дело не сказало ничего, не считается нулевым.

test "операнд без построения отклонён" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 1 / 1) { origin case_input; }
  assert "f4": product_of(entity_ref("urn:calc:pq:p"), entity_ref("urn:calc:pq:f"), entity_ref("urn:calc:pq:ghost")) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:p"), "UNDEFINED_OPERAND"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(UndefinedOperand);
}
