language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Различие с нулевым многочленом предъявлено рядом, а не оставлено читателю.

test "у ненулевой константы степень нулевая — и это ДРУГОЙ ответ" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 0) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, 7 / 1) { origin case_input; }
 }
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 0));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(zero_polynomial(entity_ref("urn:calc:pq:f")));
 expect truth_status == NEITHER;
}
