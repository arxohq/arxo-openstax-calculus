language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Умолчания у предела числа мест нет: DECISION-0123 §2 запрещает скрытые умолчания.

test "дело без ресурсного контракта отклонено" {
 given {
  assert "f0": poly(entity_ref("urn:calc:pq:f"), 1) { origin case_input; }
  assert "f1": term(entity_ref("urn:calc:pq:f"), 0, 1 / 1) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 1, 1 / 1) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:f"), "NO_RESOURCE_CONTRACT"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(NoResourceContract);
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 1));
 expect truth_status == NEITHER;
}
