language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Тот же многочлен: старший коэффициент производной равен 6 = 2 * 3.

test "коэффициент производной" {
 given {
  assert "f0": degree_cap(8) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:da"), 2) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:da"), 0, 1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:da"), 1, 2 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:da"), 2, 3 / 1) { origin case_input; }
  assert "f5": derivative_of(entity_ref("urn:calc:pq:dd"), entity_ref("urn:calc:pq:da")) { origin case_input; }
 }
 evaluate truth(coeff(entity_ref("urn:calc:pq:dd"), 1, 6 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
