language "law.core" version "0.2";
package calc.polynomials_q version "0.1.0";
namespace "urn:law:calc:polynomials-q";

// Превышение ресурса названо явно и не выдаётся ни за отсутствие многочлена, ни за его нулевой вид: нехватка бюджета — незавершённость, а не ложность.

test "многочлен шире объявленного предела отклонён" {
 given {
  assert "f0": degree_cap(1) { origin case_input; }
  assert "f1": poly(entity_ref("urn:calc:pq:f"), 3) { origin case_input; }
  assert "f2": term(entity_ref("urn:calc:pq:f"), 0, -1 / 1) { origin case_input; }
  assert "f3": term(entity_ref("urn:calc:pq:f"), 1, 0 / 1) { origin case_input; }
  assert "f4": term(entity_ref("urn:calc:pq:f"), 2, 0 / 1) { origin case_input; }
  assert "f5": term(entity_ref("urn:calc:pq:f"), 3, 1 / 1) { origin case_input; }
 }
 evaluate truth(defect(entity_ref("urn:calc:pq:f"), "SLOTS_EXCEED_CAP"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(SlotsExceedCap);
 evaluate truth(degree(entity_ref("urn:calc:pq:f"), 3));
 expect truth_status == NEITHER;
 evaluate truth(zero_polynomial(entity_ref("urn:calc:pq:f")));
 expect truth_status == NEITHER;
}
