rule DeriveLnChainNode(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer, x: Text, atag: Text, aname: Text, av: Rational, al: Integer, ar: Integer) strict {
    label ru unofficial "логарифм сложного аргумента: u′/u (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "ln", "", 0 / 1, a, 0)) and task_variable(t, x) and monotone(calc.expressions::node(e, a, atag, aname, av, al, ar)) and (atag != "var" or aname != x) and monotone(derived(t, e, a));
    then calc.expressions::node(e, f * 64 + 256, "div", "", 0 / 1, a * 64 + 256, a);
}

rule DeriveLnChainDone(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer, x: Text, atag: Text, aname: Text, av: Rational, al: Integer, ar: Integer) strict {
    label ru unofficial "производная логарифма сложного аргумента построена (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "ln", "", 0 / 1, a, 0)) and task_variable(t, x) and monotone(calc.expressions::node(e, a, atag, aname, av, al, ar)) and (atag != "var" or aname != x) and monotone(derived(t, e, a));
    then derived(t, e, f);
}

rule DeriveLnChainMethod(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer, x: Text, atag: Text, aname: Text, av: Rational, al: Integer, ar: Integer) strict {
    label ru unofficial "правило курса для строки хода (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "ln", "", 0 / 1, a, 0)) and task_variable(t, x) and monotone(calc.expressions::node(e, a, atag, aname, av, al, ar)) and (atag != "var" or aname != x) and monotone(derived(t, e, a));
    then derivative_method(t, e, f, "derivative_ln_chain");
}

// ── Квадратный корень ──────────────────────────────────────────────────────
//
// (√u)′ = u′ / (2·√u). Внешний корень ПЕРЕИСПОЛЬЗУЕТ исходный узел f: это
// ровно то же поддерево, и лишнего узла оно не стоит. Условие применимости
// — положительность подкоренного выражения в окрестности — проверяется не
// здесь, а при вычислении предела: форма области не знает.

rule DeriveSqrtTwo(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "производная корня: двойка знаменателя (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0)) and monotone(derived(t, e, a));
    then calc.expressions::node(e, f * 64 + 258, "const", "", 2 / 1, 0, 0);
}

rule DeriveSqrtDenominator(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "производная корня: знаменатель 2·√u (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0)) and monotone(derived(t, e, a));
    then calc.expressions::node(e, f * 64 + 257, "mul", "", 0 / 1, f * 64 + 258, f);
}

rule DeriveSqrtNode(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "производная корня: u′/(2·√u) (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0)) and monotone(derived(t, e, a));
    then calc.expressions::node(e, f * 64 + 256, "div", "", 0 / 1, a * 64 + 256, f * 64 + 257);
}

rule DeriveSqrtDone(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "производная корня построена (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0)) and monotone(derived(t, e, a));
    then derived(t, e, f);
}

rule DeriveSqrtMethod(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "правило курса для строки хода (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0)) and monotone(derived(t, e, a));
    then derivative_method(t, e, f, "derivative_sqrt");
}

rule NeedSqrtChild(t: Task, e: calc.expressions::Expr, f: Integer, a: Integer) strict {
    label ru unofficial "производная корня требует производной подкоренного (§3 DECISION-0198)";
    when monotone(need_derivative(t, e, f)) and monotone(calc.expressions::node(e, f, "sqrt", "", 0 / 1, a, 0));
    then need_derivative(t, e, a);
}
