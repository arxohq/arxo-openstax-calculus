language "law.core" version "0.2";
package calc.limit_solver version "0.1.0";
namespace "urn:law:calc:limit-solver";

// Находка Н2: многочлен на бесконечности. Слагаемые уходят в разные стороны
// (−x^3 против +3x), правила LimitAdd* молчат; исход решает старший член.
// Запись задачи: lim x->+inf -x^3+3x-4
// Дело предъявляет ТОЛЬКО её: ни метода, ни ответа, ни производных.
test "старший член многочлена на плюс бесконечности" {
 given {
  assert "in1": task_nodes(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes")) { origin case_input; }
  assert "in2": task_function(entity_ref("urn:law:calc:limit-solver#task"), 10) { origin case_input; }
  assert "in3": task_variable(entity_ref("urn:law:calc:limit-solver#task"), "x") { origin case_input; }
  assert "in4": task_approach(entity_ref("urn:law:calc:limit-solver#task"), "plus_inf") { origin case_input; }
  assert "in5": task_point(entity_ref("urn:law:calc:limit-solver#task"), 0 / 1) { origin case_input; }
  assert "in6": task_side(entity_ref("urn:law:calc:limit-solver#task"), "both") { origin case_input; }
  assert "in7": input_node(entity_ref("urn:law:calc:limit-solver#task"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "in8": input_node(entity_ref("urn:law:calc:limit-solver#task"), 2, "const", "", -4 / 1, 0, 0) { origin case_input; }
  assert "in9": input_node(entity_ref("urn:law:calc:limit-solver#task"), 3, "const", "", 3 / 1, 0, 0) { origin case_input; }
  assert "in10": input_node(entity_ref("urn:law:calc:limit-solver#task"), 4, "mul", "", 0 / 1, 3, 1) { origin case_input; }
  assert "in11": input_node(entity_ref("urn:law:calc:limit-solver#task"), 5, "const", "", -1 / 1, 0, 0) { origin case_input; }
  assert "in12": input_node(entity_ref("urn:law:calc:limit-solver#task"), 6, "const", "", 3 / 1, 0, 0) { origin case_input; }
  assert "in13": input_node(entity_ref("urn:law:calc:limit-solver#task"), 7, "pow", "", 0 / 1, 1, 6) { origin case_input; }
  assert "in14": input_node(entity_ref("urn:law:calc:limit-solver#task"), 8, "mul", "", 0 / 1, 5, 7) { origin case_input; }
  assert "in15": input_node(entity_ref("urn:law:calc:limit-solver#task"), 9, "add", "", 0 / 1, 2, 4) { origin case_input; }
  assert "in16": input_node(entity_ref("urn:law:calc:limit-solver#task"), 10, "add", "", 0 / 1, 9, 8) { origin case_input; }
  assert "in17": task_closed(entity_ref("urn:law:calc:limit-solver#task")) { origin case_input; }
 }
 evaluate truth(solver_result(entity_ref("urn:law:calc:limit-solver#task"), "MINUS_INFINITY", "minus_inf", 0 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
