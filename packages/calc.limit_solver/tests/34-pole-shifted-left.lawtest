language "law.core" version "0.2";
package calc.limit_solver version "0.1.0";
namespace "urn:law:calc:limit-solver";

// Находка Н1: односторонний полюс c/(x − a) при a ≠ 0 слева.
// Запись задачи: lim x->1- 4/(x-1)
// Дело предъявляет ТОЛЬКО её: ни метода, ни ответа, ни производных.
test "сдвинутый полюс первого порядка слева" {
 given {
  assert "in1": task_nodes(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes")) { origin case_input; }
  assert "in2": task_function(entity_ref("urn:law:calc:limit-solver#task"), 7) { origin case_input; }
  assert "in3": task_variable(entity_ref("urn:law:calc:limit-solver#task"), "x") { origin case_input; }
  assert "in4": task_approach(entity_ref("urn:law:calc:limit-solver#task"), "at") { origin case_input; }
  assert "in5": task_point(entity_ref("urn:law:calc:limit-solver#task"), 1 / 1) { origin case_input; }
  assert "in6": task_side(entity_ref("urn:law:calc:limit-solver#task"), "left") { origin case_input; }
  assert "in7": input_node(entity_ref("urn:law:calc:limit-solver#task"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "in8": input_node(entity_ref("urn:law:calc:limit-solver#task"), 2, "const", "", 4 / 1, 0, 0) { origin case_input; }
  assert "in9": input_node(entity_ref("urn:law:calc:limit-solver#task"), 3, "const", "", -1 / 1, 0, 0) { origin case_input; }
  assert "in10": input_node(entity_ref("urn:law:calc:limit-solver#task"), 4, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "in11": input_node(entity_ref("urn:law:calc:limit-solver#task"), 5, "mul", "", 0 / 1, 4, 1) { origin case_input; }
  assert "in12": input_node(entity_ref("urn:law:calc:limit-solver#task"), 6, "add", "", 0 / 1, 3, 5) { origin case_input; }
  assert "in13": input_node(entity_ref("urn:law:calc:limit-solver#task"), 7, "div", "", 0 / 1, 2, 6) { origin case_input; }
  assert "in14": task_closed(entity_ref("urn:law:calc:limit-solver#task")) { origin case_input; }
 }
 evaluate truth(solver_result(entity_ref("urn:law:calc:limit-solver#task"), "MINUS_INFINITY", "minus_inf", 0 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
