language "law.core" version "0.2";
package calc.limit_solver version "0.1.0";
namespace "urn:law:calc:limit-solver";

// Приёмка §8: свидетельство выводится только когда установлены ВСЕ условия — неопределённость, обе производные, предел их отношения и ненулевая производная знаменателя в окрестности.
// Запись задачи: lim x->0 (exp(x)-1)/x
// Дело предъявляет ТОЛЬКО её: ни метода, ни ответа, ни производных.
test "ход: свидетельство применения правила Лопиталя" {
 given {
  assert "in1": task_nodes(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes")) { origin case_input; }
  assert "in2": task_function(entity_ref("urn:law:calc:limit-solver#task"), 5) { origin case_input; }
  assert "in3": task_variable(entity_ref("urn:law:calc:limit-solver#task"), "x") { origin case_input; }
  assert "in4": task_approach(entity_ref("urn:law:calc:limit-solver#task"), "at") { origin case_input; }
  assert "in5": task_point(entity_ref("urn:law:calc:limit-solver#task"), 0 / 1) { origin case_input; }
  assert "in6": task_side(entity_ref("urn:law:calc:limit-solver#task"), "both") { origin case_input; }
  assert "in7": input_node(entity_ref("urn:law:calc:limit-solver#task"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "in8": input_node(entity_ref("urn:law:calc:limit-solver#task"), 2, "exp", "", 0 / 1, 1, 0) { origin case_input; }
  assert "in9": input_node(entity_ref("urn:law:calc:limit-solver#task"), 3, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "in10": input_node(entity_ref("urn:law:calc:limit-solver#task"), 4, "sub", "", 0 / 1, 2, 3) { origin case_input; }
  assert "in11": input_node(entity_ref("urn:law:calc:limit-solver#task"), 5, "div", "", 0 / 1, 4, 1) { origin case_input; }
  assert "in12": task_closed(entity_ref("urn:law:calc:limit-solver#task")) { origin case_input; }
 }
 evaluate truth(lhopital_applied(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes"), 5, 0, "right"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
