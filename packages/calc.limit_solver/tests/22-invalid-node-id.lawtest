language "law.core" version "0.2";
package calc.limit_solver version "0.1.0";
namespace "urn:law:calc:limit-solver";

// Приёмка §8: идентификатор 300 вторгается в адреса ПОРОЖДЁННЫХ узлов
// (§3 DECISION-0198). Ввод не принимается, и причина названа.
test "идентификатор входного узла вне допустимого диапазона" {
 given {
  assert "in1": task_nodes(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes")) { origin case_input; }
  assert "in2": task_function(entity_ref("urn:law:calc:limit-solver#task"), 300) { origin case_input; }
  assert "in3": task_variable(entity_ref("urn:law:calc:limit-solver#task"), "x") { origin case_input; }
  assert "in4": task_approach(entity_ref("urn:law:calc:limit-solver#task"), "at") { origin case_input; }
  assert "in5": task_point(entity_ref("urn:law:calc:limit-solver#task"), 0 / 1) { origin case_input; }
  assert "in6": task_side(entity_ref("urn:law:calc:limit-solver#task"), "both") { origin case_input; }
  assert "in7": input_node(entity_ref("urn:law:calc:limit-solver#task"), 300, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "in8": task_closed(entity_ref("urn:law:calc:limit-solver#task")) { origin case_input; }
 }
 evaluate truth(input_error(entity_ref("urn:law:calc:limit-solver#task"), "NODE_ID_OUT_OF_RANGE"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
