language "law.core" version "0.2";
package calc.limit_solver version "0.1.0";
namespace "urn:law:calc:limit-solver";

// Контрольная задача §8: lim (x−1)²/(x−1) при x → 1 равен 0; исходная область сохраняется — точка 1 в неё не входит ни до, ни после преобразования.
// Запись задачи: lim x->1 (x-1)^2/(x-1)
// Дело предъявляет ТОЛЬКО её: ни метода, ни ответа, ни производных.
test "кратный ноль числителя" {
 given {
  assert "in1": task_nodes(entity_ref("urn:law:calc:limit-solver#task"), entity_ref("urn:law:calc:limit-solver#nodes")) { origin case_input; }
  assert "in2": task_function(entity_ref("urn:law:calc:limit-solver#task"), 6) { origin case_input; }
  assert "in3": task_variable(entity_ref("urn:law:calc:limit-solver#task"), "x") { origin case_input; }
  assert "in4": task_approach(entity_ref("urn:law:calc:limit-solver#task"), "at") { origin case_input; }
  assert "in5": task_point(entity_ref("urn:law:calc:limit-solver#task"), 1 / 1) { origin case_input; }
  assert "in6": task_side(entity_ref("urn:law:calc:limit-solver#task"), "both") { origin case_input; }
  assert "in7": input_node(entity_ref("urn:law:calc:limit-solver#task"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "in8": input_node(entity_ref("urn:law:calc:limit-solver#task"), 2, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "in9": input_node(entity_ref("urn:law:calc:limit-solver#task"), 3, "sub", "", 0 / 1, 1, 2) { origin case_input; }
  assert "in10": input_node(entity_ref("urn:law:calc:limit-solver#task"), 4, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "in11": input_node(entity_ref("urn:law:calc:limit-solver#task"), 5, "pow", "", 0 / 1, 3, 4) { origin case_input; }
  assert "in12": input_node(entity_ref("urn:law:calc:limit-solver#task"), 6, "div", "", 0 / 1, 5, 3) { origin case_input; }
  assert "in13": task_closed(entity_ref("urn:law:calc:limit-solver#task")) { origin case_input; }
 }
 evaluate truth(solver_result(entity_ref("urn:law:calc:limit-solver#task"), "FINITE", "rational", 0 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
