language "law.core" version "0.2";
package openstax.calculus_derivatives version "0.1.1";
namespace "urn:openstax:clir:calculus-derivatives";

use self::{
    CD_POWER_RULE,
};
pub entity PolynomialTask { label en unofficial "one requested polynomial calculus operation"; }
pub relation polynomial_task(t: PolynomialTask, e: calc.expressions::Expr, node: Integer, variable: Text, result: calc.polynomials_q::Poly) kind empirical { label en unofficial "input expression, variable and result carrier; no answer coefficients supplied"; }
pub relation polynomial_solved(t: PolynomialTask) kind institutional { label en unofficial "the requested result polynomial is complete"; }
pub relation computed_coefficient(t: PolynomialTask, exponent: Integer, coefficient: Rational) kind institutional { label en unofficial "native computed coefficient; canonical coefficients through the nonzero degree, including internal zero coefficients"; }
pub relation computed_zero_polynomial(t: PolynomialTask) kind institutional { label en unofficial "the complete output is exactly the zero polynomial"; }
pub relation polynomial_problem(t: PolynomialTask, reason: Text) kind institutional { label en unofficial "an explicit input or supported-class boundary"; }
relation unique_task(t: PolynomialTask) kind institutional { label en unofficial "each request field is unique"; }
relation task_expression(t: PolynomialTask, value: calc.expressions::Expr) kind institutional { label en unofficial "request field projection for exact uniqueness"; }
rule Project_task_expression(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "read a request field without mathematical transformation"; when polynomial_task(t,e,f,x,d); then task_expression(t,e); }
relation task_node(t: PolynomialTask, value: Integer) kind institutional { label en unofficial "request field projection for exact uniqueness"; }
rule Project_task_node(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "read a request field without mathematical transformation"; when polynomial_task(t,e,f,x,d); then task_node(t,f); }
relation task_variable(t: PolynomialTask, value: Text) kind institutional { label en unofficial "request field projection for exact uniqueness"; }
rule Project_task_variable(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "read a request field without mathematical transformation"; when polynomial_task(t,e,f,x,d); then task_variable(t,x); }
relation task_result(t: PolynomialTask, value: calc.polynomials_q::Poly) kind institutional { label en unofficial "request field projection for exact uniqueness"; }
rule Project_task_result(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "read a request field without mathematical transformation"; when polynomial_task(t,e,f,x,d); then task_result(t,d); }
rule UniqueTask(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "all request fields are globally unique"; when polynomial_task(t,e,f,x,d) and (count distinct z: calc.expressions::Expr where task_expression(t,z)) == 1 and (count distinct z: Integer where task_node(t,z)) == 1 and (count distinct z: Text where task_variable(t,z)) == 1 and (count distinct z: calc.polynomials_q::Poly where task_result(t,z)) == 1; then unique_task(t); }
rule Ambiguous_task_expression(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "duplicate request fields refuse a choice"; when polynomial_task(t,e,f,x,d) and (count distinct z: calc.expressions::Expr where task_expression(t,z)) > 1; then polynomial_problem(t,"AMBIGUOUS_TASK"); }
rule Ambiguous_task_node(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "duplicate request fields refuse a choice"; when polynomial_task(t,e,f,x,d) and (count distinct z: Integer where task_node(t,z)) > 1; then polynomial_problem(t,"AMBIGUOUS_TASK"); }
rule Ambiguous_task_variable(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "duplicate request fields refuse a choice"; when polynomial_task(t,e,f,x,d) and (count distinct z: Text where task_variable(t,z)) > 1; then polynomial_problem(t,"AMBIGUOUS_TASK"); }
rule Ambiguous_task_result(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "duplicate request fields refuse a choice"; when polynomial_task(t,e,f,x,d) and (count distinct z: calc.polynomials_q::Poly where task_result(t,z)) > 1; then polynomial_problem(t,"AMBIGUOUS_TASK"); }

@source(CD_POWER_RULE)
pub rule ComputedCoefficient(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly,k: Integer,c: Rational, slots: Integer) strict { label en unofficial "return only complete native calculated coefficients"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.polynomials_q::ready(d,slots) and calc.polynomials_q::coeff(d,k,c); then computed_coefficient(t,k,c); }
@source(CD_POWER_RULE)
pub rule PolynomialSolved(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly, slots: Integer) strict { label en unofficial "the native result carrier is ready"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.polynomials_q::ready(d,slots); then polynomial_solved(t); }
@source(CD_POWER_RULE)
pub rule ComputedZero(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly, slots: Integer) strict { label en unofficial "zero is explicitly established, not inferred from an empty coefficient collection"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.polynomials_q::ready(d,slots) and calc.polynomials_q::zero_polynomial(d); then computed_zero_polynomial(t); }
rule UnsupportedPolynomial(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "a supported expression outside univariate polynomials remains unsupported"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.polynomials_q::not_polynomial(e,f); then polynomial_problem(t,"UNSUPPORTED_FORM"); }
rule MissingBudget(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "the explicit polynomial resource contract is required"; when polynomial_task(t,e,f,x,d) and (count distinct cap: Integer where calc.polynomials_q::degree_cap(cap)) == 0; then polynomial_problem(t,"MISSING_RESOURCE_CONTRACT"); }
rule OutputDefect(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly,code: Text) strict { label en unofficial "expose output descriptor defects"; when polynomial_task(t,e,f,x,d) and calc.polynomials_q::defect(d,code); then polynomial_problem(t,code); }
@source(CD_POWER_RULE)
pub rule RequestDerivative(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly,p: calc.polynomials_q::Poly) strict { label en unofficial "differentiate the native polynomial representation of the input expression"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.polynomials_q::polynomial_of(e,f,x,p); then calc.polynomials_q::derivative_of(d,p); }
rule UnsupportedPowerBase(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly,n: Integer,a: Integer,b: Integer,tag: Text,name: Text,value: Rational,l: Integer,rr: Integer) strict { label en unofficial "the first polynomial expression bridge admits powers of the chosen variable only"; when polynomial_task(t,e,f,x,d) and calc.expressions::reachable(e,f,n) and calc.expressions::node(e,n,"pow","",0 / 1,a,b) and calc.expressions::node(e,a,tag,name,value,l,rr) and tag != "var"; then polynomial_problem(t,"UNSUPPORTED_POWER_BASE"); }
rule ExpressionNotEstablished(t: PolynomialTask,e: calc.expressions::Expr,f: Integer,x: Text,d: calc.polynomials_q::Poly) strict { label en unofficial "well-formedness is not established for the closed input expression; this does not invent a mathematical answer"; when unique_task(t) and polynomial_task(t,e,f,x,d) and calc.expressions::closed(e) and not_known(calc.expressions::well_formed(e,f)); then polynomial_problem(t,"EXPRESSION_NOT_ESTABLISHED"); }
