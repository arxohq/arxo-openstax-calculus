language "law.core" version "0.2";
package openstax.calculus_derivatives version "0.1.1";
namespace "urn:openstax:clir:calculus-derivatives";

// ПОКАЗ ИНСТРУКЦИИ БЕЗ ДЕЛА: у правила степени названы посылка и заключение, и этого довольно, чтобы его ПОКАЗАТЬ. Ни одного заключения о предъявленном ходе отсюда не следует — граница logic.core.

test "инструкция показывается без всякого дела" {
    given {
        assert "m": rule_method(entity_ref("urn:case:cd:r1"), "power_rule") { origin case_input; }
        assert "p1": rule_premise(entity_ref("urn:case:cd:r1"), 1, "n — целое положительное, f(x) = x^n") { origin case_input; }
        assert "c": rule_conclusion(entity_ref("urn:case:cd:r1"), "f'(x) = n·x^(n−1)") { origin case_input; }
    }

    evaluate truth(instruction_available(entity_ref("urn:case:cd:r1")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(InstructionAvailable);
}
