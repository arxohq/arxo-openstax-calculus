language "law.core" version "0.2";
package openstax.calculus_derivatives version "0.1.1";
namespace "urn:openstax:clir:calculus-derivatives";

// §3.3: постоянный множитель выносится за знак производной.

test "шаг обоснован постоянным множителем" {
    given {
        assert "d": calc.calculus_checker::document(entity_ref("urn:case:cd:d1"), 2, 4, "calculus/1") { origin case_input; }
        assert "ctx": calc.calculus_checker::nodes_of(entity_ref("urn:case:cd:d1"), entity_ref("urn:case:cd:e1")) { origin case_input; }
        assert "v": calc.calculus_checker::variable(entity_ref("urn:case:cd:d1"), "x") { origin case_input; }
        assert "n1": calc.expressions::node(entity_ref("urn:case:cd:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
        assert "n2": calc.expressions::node(entity_ref("urn:case:cd:e1"), 2, "cos", "", 0 / 1, 1, 0) { origin case_input; }
        assert "n3": calc.expressions::node(entity_ref("urn:case:cd:e1"), 3, "const", "", 7 / 1, 0, 0) { origin case_input; }
        assert "n4": calc.expressions::node(entity_ref("urn:case:cd:e1"), 4, "mul", "", 0 / 1, 3, 2) { origin case_input; }
        assert "l1": calc.calculus_checker::line(entity_ref("urn:case:cd:d1"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
        assert "l2": calc.calculus_checker::line(entity_ref("urn:case:cd:d1"), 2, 4, "constant_multiple", 1, 0, 0, 0) { origin case_input; }
        assert "rm": rule_method(entity_ref("urn:case:cd:r1"), "constant_multiple") { origin case_input; }
        assert "clx": calc.expressions::closed(entity_ref("urn:case:cd:e1")) { origin case_input; }
        assert "clp": calc.calculus_checker::closed(entity_ref("urn:case:cd:d1")) { origin case_input; }
    }

    evaluate truth(step_justified_by(entity_ref("urn:case:cd:d1"), 2, entity_ref("urn:case:cd:r1")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(ConstantMultipleJustifies);
}
