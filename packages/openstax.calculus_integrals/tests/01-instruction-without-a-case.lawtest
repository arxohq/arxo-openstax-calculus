language "law.core" version "0.2";
package openstax.calculus_integrals version "0.1.1";
namespace "urn:openstax:clir:calculus-integrals";

// Формула интегрирования по частям ПОКАЗЫВАЕТСЯ из описания. Какое из разложений брать — решает студент; Arxo выбор u и dv не делает никогда.

test "формула по частям показывается без дела" {
    given {
        assert "m": rule_method(entity_ref("urn:case:cd:r1"), "by_parts") { origin case_input; }
        assert "p1": rule_premise(entity_ref("urn:case:cd:r1"), 1, "u = f(x) и v = g(x) имеют непрерывные производные") { origin case_input; }
        assert "c": rule_conclusion(entity_ref("urn:case:cd:r1"), "∫u dv = u·v − ∫v du") { origin case_input; }
    }

    evaluate truth(instruction_available(entity_ref("urn:case:cd:r1")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(InstructionAvailable);
}
