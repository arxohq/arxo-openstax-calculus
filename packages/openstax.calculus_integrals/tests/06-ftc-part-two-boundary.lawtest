language "law.core" version "0.2";
package openstax.calculus_integrals version "0.1.1";
namespace "urn:openstax:clir:calculus-integrals";

// §5.3 FTC Part 2: условия Ньютона–Лейбница (f непрерывна на [a, b],
// F — первообразная f) входят в словарь как инструкция — ПОКАЗ, не
// выполнение. Сам шаг в v1 не проверяется, и это записано принимающей
// ветвью, а не мёртвым правилом.

test "условия Ньютона–Лейбница показываются инструкцией" {
    given {
        assert "rm": rule_method(entity_ref("urn:case:ci:ftc"), "fundamental_theorem") { origin case_input; }
        assert "rp1": rule_premise(entity_ref("urn:case:ci:ftc"), 1, "f непрерывна на [a, b]") { origin case_input; }
        assert "rp2": rule_premise(entity_ref("urn:case:ci:ftc"), 2, "F — первообразная f") { origin case_input; }
        assert "rc": rule_conclusion(entity_ref("urn:case:ci:ftc"), "∫ₐᵇ f = F(b) − F(a)") { origin case_input; }
    }

    evaluate truth(instruction_available(entity_ref("urn:case:ci:ftc")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(InstructionAvailable);
}

test "шаг по основной теореме принят названной границей" {
    given {
        assert "d": calc.calculus_checker::document(entity_ref("urn:case:ci:d2"), 2, 3, "calculus/1") { origin case_input; }
        assert "ctx": calc.calculus_checker::nodes_of(entity_ref("urn:case:ci:d2"), entity_ref("urn:case:ci:e2")) { origin case_input; }
        assert "var": calc.calculus_checker::variable(entity_ref("urn:case:ci:d2"), "x") { origin case_input; }
        assert "n1": calc.expressions::node(entity_ref("urn:case:ci:e2"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
        assert "n2": calc.expressions::node(entity_ref("urn:case:ci:e2"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
        assert "n3": calc.expressions::node(entity_ref("urn:case:ci:e2"), 3, "cos", "", 0 / 1, 1, 0) { origin case_input; }
        assert "l1": calc.calculus_checker::line(entity_ref("urn:case:ci:d2"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
        assert "l2": calc.calculus_checker::line(entity_ref("urn:case:ci:d2"), 2, 3, "fundamental_theorem", 1, 0, 0, 0) { origin case_input; }
        assert "rm": rule_method(entity_ref("urn:case:ci:ftc2"), "fundamental_theorem") { origin case_input; }
        assert "clx": calc.expressions::closed(entity_ref("urn:case:ci:e2")) { origin case_input; }
        assert "clp": calc.calculus_checker::closed(entity_ref("urn:case:ci:d2")) { origin case_input; }
    }

    evaluate truth(ftc2_boundary_accepted(entity_ref("urn:case:ci:d2"), 2, entity_ref("urn:case:ci:ftc2")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(Ftc2BoundaryAccepted);
}

// Проверенный шаг другой методы границей FTC-2 не принимается: принимающая
// ветвь срабатывает только на METHOD_NOT_IN_V1, а не на всякий шаг.
test "проверенный шаг иной методы границей не принимается" {
    given {
        assert "d": calc.calculus_checker::document(entity_ref("urn:case:cd:d1"), 2, 7, "calculus/1") { origin case_input; }
        assert "ctx": calc.calculus_checker::nodes_of(entity_ref("urn:case:cd:d1"), entity_ref("urn:case:cd:e1")) { origin case_input; }
        assert "v": calc.calculus_checker::variable(entity_ref("urn:case:cd:d1"), "x") { origin case_input; }
        assert "n1": calc.expressions::node(entity_ref("urn:case:cd:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
        assert "n2": calc.expressions::node(entity_ref("urn:case:cd:e1"), 2, "const", "", 2 / 1, 0, 0) { origin case_input; }
        assert "n3": calc.expressions::node(entity_ref("urn:case:cd:e1"), 3, "pow", "", 0 / 1, 1, 2) { origin case_input; }
        assert "n4": calc.expressions::node(entity_ref("urn:case:cd:e1"), 4, "const", "", 1 / 3, 0, 0) { origin case_input; }
        assert "n5": calc.expressions::node(entity_ref("urn:case:cd:e1"), 5, "const", "", 3 / 1, 0, 0) { origin case_input; }
        assert "n6": calc.expressions::node(entity_ref("urn:case:cd:e1"), 6, "pow", "", 0 / 1, 1, 5) { origin case_input; }
        assert "n7": calc.expressions::node(entity_ref("urn:case:cd:e1"), 7, "mul", "", 0 / 1, 4, 6) { origin case_input; }
        assert "l1": calc.calculus_checker::line(entity_ref("urn:case:cd:d1"), 1, 3, "given", 0, 0, 0, 0) { origin case_input; }
        assert "l2": calc.calculus_checker::line(entity_ref("urn:case:cd:d1"), 2, 7, "antiderivative_power", 1, 0, 0, 0) { origin case_input; }
        assert "rm": rule_method(entity_ref("urn:case:cd:r1"), "antiderivative_power") { origin case_input; }
        assert "clx": calc.expressions::closed(entity_ref("urn:case:cd:e1")) { origin case_input; }
        assert "clp": calc.calculus_checker::closed(entity_ref("urn:case:cd:d1")) { origin case_input; }
    }

    evaluate truth(ftc2_boundary_accepted(entity_ref("urn:case:cd:d1"), 2, entity_ref("urn:case:cd:r1")));

    expect truth_status == NEITHER;
    expect evaluation_status == COMPUTED;
}
