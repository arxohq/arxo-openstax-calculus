language "law.core" version "0.2";
package openstax.calculus_integrals version "0.1.1";
namespace "urn:openstax:clir:calculus-integrals";

// §4.10 Integration Formulas, седьмая строка таблицы: ∫sin x dx = −cos x + C.

test "шаг обоснован таблицей первообразных: синус" {
    given {
        assert "d": calc.calculus_checker::document(entity_ref("urn:case:cd:d2"), 2, 4, "calculus/1") { origin case_input; }
        assert "ctx": calc.calculus_checker::nodes_of(entity_ref("urn:case:cd:d2"), entity_ref("urn:case:cd:e2")) { origin case_input; }
        assert "v": calc.calculus_checker::variable(entity_ref("urn:case:cd:d2"), "x") { origin case_input; }
        assert "n1": calc.expressions::node(entity_ref("urn:case:cd:e2"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
        assert "n2": calc.expressions::node(entity_ref("urn:case:cd:e2"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
        assert "n3": calc.expressions::node(entity_ref("urn:case:cd:e2"), 3, "cos", "", 0 / 1, 1, 0) { origin case_input; }
        assert "n4": calc.expressions::node(entity_ref("urn:case:cd:e2"), 4, "neg", "", 0 / 1, 3, 0) { origin case_input; }
        assert "l1": calc.calculus_checker::line(entity_ref("urn:case:cd:d2"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
        assert "l2": calc.calculus_checker::line(entity_ref("urn:case:cd:d2"), 2, 4, "table_antiderivative", 1, 0, 0, 0) { origin case_input; }
        assert "rm": rule_method(entity_ref("urn:case:cd:r2"), "table_antiderivative") { origin case_input; }
        assert "clx": calc.expressions::closed(entity_ref("urn:case:cd:e2")) { origin case_input; }
        assert "clp": calc.calculus_checker::closed(entity_ref("urn:case:cd:d2")) { origin case_input; }
    }

    evaluate truth(step_justified_by(entity_ref("urn:case:cd:d2"), 2, entity_ref("urn:case:cd:r2")));

    expect truth_status == TRUE_ONLY;
    expect evaluation_status == COMPUTED;
    expect applied(TableAntiderivativeJustifies);
}
