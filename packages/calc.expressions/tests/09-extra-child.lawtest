language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

// У константы предъявлен дочерний узел.

test "extra-child" {
 given {
  assert "n1": node(entity_ref("urn:calc:ex:e1"), 1, "const", "", 1 / 1, 2, 0) { origin case_input; }
  assert "n2": node(entity_ref("urn:calc:ex:e1"), 2, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "cl": closed(entity_ref("urn:calc:ex:e1")) { origin case_input; }
 }
 evaluate truth(formula_error(entity_ref("urn:calc:ex:e1"), 1, "EXTRA_CHILD"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ExtraChildOnConst);
}
