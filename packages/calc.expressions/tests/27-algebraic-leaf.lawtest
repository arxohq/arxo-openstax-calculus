language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

test "алгебраический лист хранит дескриптор структурно, не решая математическое равенство" {
 given {
  assert "f1": node(entity_ref("urn:calc:expr:algebraic"), 1, "algebraic", "root:poly=x2-2;interval=1,2", 0 / 1, 0, 0) { origin case_input; }
  assert "f2": node(entity_ref("urn:calc:expr:algebraic"), 2, "algebraic", "root:poly=x2-2;interval=1,2", 0 / 1, 0, 0) { origin case_input; }
  assert "f3": node(entity_ref("urn:calc:expr:algebraic"), 3, "algebraic", "root:poly=x2-2;interval=-2,-1", 0 / 1, 0, 0) { origin case_input; }
  assert "f4": closed(entity_ref("urn:calc:expr:algebraic")) { origin case_input; }
 }
 evaluate truth(well_formed(entity_ref("urn:calc:expr:algebraic"), 1));
 expect truth_status == TRUE_ONLY;
 evaluate truth(equivalent(entity_ref("urn:calc:expr:algebraic"), 1, 2));
 expect truth_status == TRUE_ONLY;
 evaluate truth(equivalent(entity_ref("urn:calc:expr:algebraic"), 1, 3));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
