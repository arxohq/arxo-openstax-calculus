language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

// Цикл по дочерним ссылкам: конечного поддерева нет.

test "cycle" {
 given {
  assert "n1": node(entity_ref("urn:calc:ex:e1"), 1, "neg", "", 0 / 1, 1, 0) { origin case_input; }
  assert "cl": closed(entity_ref("urn:calc:ex:e1")) { origin case_input; }
 }
 evaluate truth(formula_error(entity_ref("urn:calc:ex:e1"), 1, "NODE_NOT_WELL_FORMED"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(NodeNotWellFormed);
}
