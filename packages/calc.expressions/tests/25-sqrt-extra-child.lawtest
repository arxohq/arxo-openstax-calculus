language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

// DECISION-0198 §2: у корня один дочерний; второй — названный дефект, а не
// молчаливое усечение.
test "квадратный корень с лишним дочерним" {
 given {
  assert "a1": node(entity_ref("urn:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "a2": node(entity_ref("urn:e"), 2, "sqrt", "", 0 / 1, 1, 1) { origin case_input; }
  assert "a3": closed(entity_ref("urn:e")) { origin case_input; }
 }
 evaluate truth(formula_error(entity_ref("urn:e"), 2, "EXTRA_CHILD"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
