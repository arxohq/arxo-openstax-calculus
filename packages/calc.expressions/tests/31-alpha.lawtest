language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

// СООТВЕТСТВИЕ СВЯЗЫВАНИЙ ПОД ПЕРЕИМЕНОВАНИЕМ (цель §5).
//
// `equivalent` решает структурное равенство, и по делу не отвечает на вопрос
// про α. Этот сценарий решает ДРУГОЕ и называет границу: существует ли взаимно
// однозначное соответствие между связанными именами двух поддеревьев, не
// затрагивающее свободные. Полное равенство выражений здесь не строится.
//
// ПЕРВОЕ. Поддерево 1 связывает z, поддерево 2 связывает w. Соответствие
// 1↔2 предложено, взаимно однозначно, и свободные имена не затрагиваются.
//
// ВТОРОЕ ВАЖНЕЕ. Там предложенное новое имя СВОБОДНО в первом поддереве:
// переименование связывания захватило бы свободную переменную. Это ровно тот
// случай, который в calc.expression_substitution/03-alpha снимается освежением
// имени, а здесь — ОТКАЗЫВАЕТСЯ, потому что освежать нечего: поддеревья уже
// предъявлены. Разные роли, одна и та же посторонняя опасность.
//
// ТРЕТЬЕ. Инъективность: два разных связанных имени сошлись в одно. Соответствие
// не обратимо, и α-конверсия теряет смысл — пакет это называет.

test "binding subtrees correspond by a bijection that leaves free names alone" {
 given {
  // выражение: 1 = (λz. z + x) + 2, где 2 = (λw. w * x)
  assert "n1": node(entity_ref("urn:law:calc:expressions#a1"), 1, "sum", "", 0 / 1, 3, 7) { origin case_input; }
  assert "n2": node(entity_ref("urn:law:calc:expressions#a1"), 2, "sum", "", 0 / 1, 4, 5) { origin case_input; }
  assert "n3": node(entity_ref("urn:law:calc:expressions#a1"), 3, "binder", "z", 0 / 1, 2, 0) { origin case_input; }
  assert "n4": node(entity_ref("urn:law:calc:expressions#a1"), 4, "var", "z", 0 / 1, 0, 0) { origin case_input; }
  assert "n5": node(entity_ref("urn:law:calc:expressions#a1"), 5, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n6": node(entity_ref("urn:law:calc:expressions#a1"), 6, "binder", "w", 0 / 1, 8, 0) { origin case_input; }
  assert "n7": node(entity_ref("urn:law:calc:expressions#a1"), 7, "mul", "", 0 / 1, 8, 5) { origin case_input; }
  assert "n8": node(entity_ref("urn:law:calc:expressions#a1"), 8, "var", "w", 0 / 1, 0, 0) { origin case_input; }

  assert "b1": binder_declared(entity_ref("urn:law:calc:expressions#a1"), 3, "z") { origin case_input; }
  assert "b2": binder_declared(entity_ref("urn:law:calc:expressions#a1"), 6, "w") { origin case_input; }
  assert "u1": node_uses(entity_ref("urn:law:calc:expressions#a1"), 5, "x") { origin case_input; }

  // кандидаты и предложенное соответствие
  assert "c1": alpha_candidate(entity_ref("urn:law:calc:expressions#a1"), 3, 6) { origin case_input; }
  assert "p1": alpha_pair(entity_ref("urn:law:calc:expressions#a1"), 3, 6, 3, 6, "z", "w") { origin case_input; }
 }

 evaluate truth(binder_in(entity_ref("urn:law:calc:expressions#a1"), 3, 3, "z"));
 expect truth_status == TRUE_ONLY;
 expect applied(BinderUnder);
 evaluate truth(free_in(entity_ref("urn:law:calc:expressions#a1"), 3, "x"));
 expect truth_status == TRUE_ONLY;
 expect applied(FreeUnder);

 evaluate truth(alpha_pair(entity_ref("urn:law:calc:expressions#a1"), 3, 6, 3, 6, "z", "w"));
 expect truth_status == TRUE_ONLY;
 expect applied(PairWellStated);

 // четыре условия выполнены одновременно
 evaluate truth(alpha_equiv(entity_ref("urn:law:calc:expressions#a1"), 3, 6));
 expect truth_status == TRUE_ONLY;
 expect applied(AlphaEquiv);

 evaluate truth(alpha_error(entity_ref("urn:law:calc:expressions#a1"), 3, 6, "ALPHA_NOT_INJECTIVE"));
 expect truth_status == NEITHER;
 evaluate truth(alpha_error(entity_ref("urn:law:calc:expressions#a1"), 3, 6, "ALPHA_FREE_TOUCHED"));
 expect truth_status == NEITHER;
}

test "a new bound name that is already free in the first subtree is refused" {
 given {
  // поддерево 1 связывает z, и В НЁМ ЖЕ есть свободная x
  assert "n1": node(entity_ref("urn:law:calc:expressions#a2"), 1, "binder", "z", 0 / 1, 2, 0) { origin case_input; }
  assert "n2": node(entity_ref("urn:law:calc:expressions#a2"), 2, "sum", "", 0 / 1, 3, 4) { origin case_input; }
  assert "n3": node(entity_ref("urn:law:calc:expressions#a2"), 3, "var", "z", 0 / 1, 0, 0) { origin case_input; }
  assert "n4": node(entity_ref("urn:law:calc:expressions#a2"), 4, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  // поддерево 5 связывает именно x
  assert "n5": node(entity_ref("urn:law:calc:expressions#a2"), 5, "binder", "x", 0 / 1, 6, 0) { origin case_input; }
  assert "n6": node(entity_ref("urn:law:calc:expressions#a2"), 6, "var", "x", 0 / 1, 0, 0) { origin case_input; }

  assert "b1": binder_declared(entity_ref("urn:law:calc:expressions#a2"), 1, "z") { origin case_input; }
  assert "b2": binder_declared(entity_ref("urn:law:calc:expressions#a2"), 5, "x") { origin case_input; }
  assert "u1": node_uses(entity_ref("urn:law:calc:expressions#a2"), 4, "x") { origin case_input; }

  // предлагается переименовать связанное z первого поддерева в x второго
  assert "c1": alpha_candidate(entity_ref("urn:law:calc:expressions#a2"), 1, 5) { origin case_input; }
  assert "p1": alpha_pair(entity_ref("urn:law:calc:expressions#a2"), 1, 5, 1, 5, "z", "x") { origin case_input; }
 }

 // x действительно свободна в первом поддереве
 evaluate truth(free_in(entity_ref("urn:law:calc:expressions#a2"), 1, "x"));
 expect truth_status == TRUE_ONLY;

 // и это ЗАХВАТ, названный отдельно: переименование связывания в имя, уже
 // свободное в том же поддереве
 evaluate truth(alpha_error(entity_ref("urn:law:calc:expressions#a2"), 1, 5, "ALPHA_FREE_TOUCHED"));
 expect truth_status == TRUE_ONLY;
 expect applied(FreeTouched);

 evaluate truth(alpha_equiv(entity_ref("urn:law:calc:expressions#a2"), 1, 5));
 expect truth_status == NEITHER;
}
