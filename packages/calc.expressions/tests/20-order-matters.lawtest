language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

// Порядок частей существен: x - 1 и 1 - x структурно различны, и равенство НЕ выводится.

test "order-matters" {
 given {
  assert "n1": node(entity_ref("urn:calc:ex:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": node(entity_ref("urn:calc:ex:e1"), 2, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "n3": node(entity_ref("urn:calc:ex:e1"), 3, "sub", "", 0 / 1, 1, 2) { origin case_input; }
  assert "n4": node(entity_ref("urn:calc:ex:e1"), 4, "sub", "", 0 / 1, 2, 1) { origin case_input; }
  assert "cl": closed(entity_ref("urn:calc:ex:e1")) { origin case_input; }
 }
 evaluate truth(equivalent(entity_ref("urn:calc:ex:e1"), 3, 4));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
}
