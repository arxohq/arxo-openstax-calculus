language "law.core" version "0.2";
package calc.expressions version "0.1.0";
namespace "urn:law:calc:expressions";

use self::{
    Expr,
    unary,
    unique_node,
};

// ── ИНТЕГРАЛ И ПРОИЗВОДНАЯ (scope B02.01) ──────────────────────────────────
//
// Каталог B02.01 называет помимо прочего интегралы, производные, матрицы,
// комплексные и кусочные выражения.
//
//   интеграл  ∫_a^b f — подынтегральная функция, нижний и верхний пределы:
//              это ТРИ слота плюс имя переменной, а слотов два;
//   производная f' по переменной — функция и переменная: это третий слот;
//   матрица m×n — число элементов не помещается в два целых;
//   комплексное число — пара (действительная, мнимая), и пара не помещается в
//              (значение, левый потомок) без выбора представления, то есть без
//              решения, которое принимает владелец формата;
//   кусочное выражение — две ветви и условие, то есть снова три слота.
//
// Объявлять эти три «неизвестным тегом» (UNKNOWN_TAG) было бы ПРАВДОЙ, но
// бесполезной: неизвестный тег означает «словарь не знает», а здесь словарь
// знает, что это матрица, и сказать «представления нет» — более точное
// утверждение. Поэтому у каждого своё имя, и все три говорят одно и то же по
// существу: ФОРМА НЕСЁТ ДВА ПОТОМКА, А ЭТОМУ НУЖНО БОЛЬШЕ.
//
// ДВА ВИДА, КОТОРЫЕ ПОМЕЩАЮТСЯ, ДЕЛАЮТСЯ ПЕРВОКЛАССНЫМИ. `integral` и
// `derivative` — унарные узлы, у которых имя несёт ПЕРЕМЕННУЮ, по которой
// берётся производная или интегрируется, а потомок — подынтегральную
// функцию. Это соглашение, а не случайность, и оно сказано здесь и в README:
// имя унарного узла у этих двух видов занято, и виды, требующие свободного
// имени (`sin`, `ln`, `sqrt`), к ним не относятся. Ничего не вычисляется:
// появляется вид узла, а не операция.

// Интеграл и производная — унарные узлы с именем-переменной.

rule UnaryIntegral(e: Expr, f: Integer, a: Integer, z: Text) strict {
    label en unofficial "интеграл — унарный узел, имя которого несёт переменную интегрирования, а потомок — подынтегральную функцию";
    when unique_node(e, f, "integral", z, 0 / 1, a, 0) and z != "";
    then unary(e, f, "integral", a);
}

rule UnaryDerivative(e: Expr, f: Integer, a: Integer, z: Text) strict {
    label en unofficial "производная — унарный узел, имя которого несёт переменную дифференцирования, а потомок — функцию";
    when unique_node(e, f, "derivative", z, 0 / 1, a, 0) and z != "";
    then unary(e, f, "derivative", a);
}

// ПРОЧИЕ ТРИ: ФОРМАТ РЕШЁН, И ОТКАЗЫ УДАЛЕНЫ, А НЕ ПЕРЕПИСАНЫ.
//
// Первая редакция этого файла отказывала `matrix`, `complex` и `piecewise`
// ПОИМЕННО — MATRIX_NODE_UNSUPPORTED, COMPLEX_NODE_UNSUPPORTED,
// PIECEWISE_NODE_UNSUPPORTED — и отказ был честным: узел несёт (тег, имя,
// значение, левый потомок, правый потомок), а комплексному нужна пара, кусочному
// условие и две ветви, матрице две размерности и элементы. Формат тогда не был
// решён, он ОТСУТСТВОВАЛ.
//
// Теперь он решён явно (10-structured.law): пара ложится в двух потомках, третье
// место — узел `branch`, две размерности — узел `dims` плюс цепочка `entry`.
// Три отказа УДАЛЕНЫ, а не смягчены: оставить их означало бы утверждать в одном
// мире, что вид узла и не представлен, и представлен.
//
// НИЧЕГО НЕ ВЫЧИСЛЯЕТСЯ. Появляется вид узла и его разобранные части, то есть
// представление существует и доступно; арифметики ни матриц, ни комплексных, ни
// кусочных здесь нет.
//
// Интеграл и производная — унарные узлы с именем-переменной.
