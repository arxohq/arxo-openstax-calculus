language "law.core" version "0.2";
package openstax.calculus_limits version "0.1.1";
namespace "urn:openstax:clir:calculus-limits";

// CL_CANCEL: живой ход, без подстановки step_valid фактом дела.
test "фрагмент CL_CANCEL: factor_and_cancel" {
 given {
  assert "f0": calc.calculus_checker::document(entity_ref("urn:calc:limits:p"), 2, 6, "calculus/2") { origin case_input; }
  assert "f1": calc.calculus_checker::nodes_of(entity_ref("urn:calc:limits:p"), entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f2": calc.calculus_checker::variable(entity_ref("urn:calc:limits:p"), "x") { origin case_input; }
  assert "f3": calc.calculus_checker::closed(entity_ref("urn:calc:limits:p")) { origin case_input; }
  assert "f4": calc.expressions::closed(entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f5": calc.expressions::node(entity_ref("urn:calc:limits:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "f6": calc.expressions::node(entity_ref("urn:calc:limits:e"), 2, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "f7": calc.expressions::node(entity_ref("urn:calc:limits:e"), 3, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "f8": calc.expressions::node(entity_ref("urn:calc:limits:e"), 4, "const", "", 0 / 1, 0, 0) { origin case_input; }
  assert "f9": calc.expressions::node(entity_ref("urn:calc:limits:e"), 5, "pow", "", 0 / 1, 1, 3) { origin case_input; }
  assert "f10": calc.expressions::node(entity_ref("urn:calc:limits:e"), 6, "div", "", 0 / 1, 5, 1) { origin case_input; }
  assert "f11": calc.expressions::node(entity_ref("urn:calc:limits:e"), 7, "div", "", 0 / 1, 1, 2) { origin case_input; }
  assert "f12": calc.polynomials_q::degree_cap(12) { origin case_input; }
  assert "f13": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 1, entity_ref("urn:calc:limits:poly1")) { origin case_input; }
  assert "f14": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 2, entity_ref("urn:calc:limits:poly2")) { origin case_input; }
  assert "f15": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 3, entity_ref("urn:calc:limits:poly3")) { origin case_input; }
  assert "f16": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 5, entity_ref("urn:calc:limits:poly5")) { origin case_input; }
  assert "f17": calc.calculus_checker::limit_cancellation(entity_ref("urn:calc:limits:p"), 2, entity_ref("urn:calc:limits:cancel")) { origin case_input; }
  assert "f18": calc.polynomials_q::cancellation_request(entity_ref("urn:calc:limits:cancel"), entity_ref("urn:calc:limits:poly5"), entity_ref("urn:calc:limits:poly1"), 0 / 1) { origin case_input; }
  assert "f19": calc.polynomials_q::cancellation_workspace(entity_ref("urn:calc:limits:cancel"), entity_ref("urn:calc:limits:factor"), entity_ref("urn:calc:limits:dn"), entity_ref("urn:calc:limits:dd"), entity_ref("urn:calc:limits:qn"), entity_ref("urn:calc:limits:rn"), entity_ref("urn:calc:limits:qd"), entity_ref("urn:calc:limits:rd")) { origin case_input; }
  assert "f20": calc.polynomials_q::produced(entity_ref("urn:calc:limits:qn"), 2) { origin case_input; }
  assert "f21": calc.polynomials_q::produced(entity_ref("urn:calc:limits:rn"), 2) { origin case_input; }
  assert "f22": calc.polynomials_q::produced(entity_ref("urn:calc:limits:qd"), 2) { origin case_input; }
  assert "f23": calc.polynomials_q::produced(entity_ref("urn:calc:limits:rd"), 2) { origin case_input; }
  assert "f24": calc.calculus_checker::limit_line(entity_ref("urn:calc:limits:p"), 1, 7, "direct_substitution", 0, 0, 0, "at", 0 / 1, "both", "expr", 4) { origin case_input; }
  assert "f25": calc.calculus_checker::limit_line(entity_ref("urn:calc:limits:p"), 2, 6, "factor_and_cancel", 1, 0, 0, "at", 0 / 1, "both", "expr", 4) { origin case_input; }
  assert "f26": rule_method(entity_ref("urn:openstax:limits:rule"), "factor_and_cancel") { origin case_input; }
 }
 evaluate truth(step_justified_by(entity_ref("urn:calc:limits:p"), 2, entity_ref("urn:openstax:limits:rule")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(JustifyFactorAndCancel10);
}
