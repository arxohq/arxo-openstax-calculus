test "limit-cancel" {
 given {

 context { legal_time @2026-10-14; knowledge_time @2026-10-14T12:00:00Z; decision_time @2026-10-14T12:00:00Z; timezone "UTC"; }
 assert "input-1": automatic_limit_task(entity_ref("urn:example:calculus:task")) { origin case_input; }
 assert "input-2": calc.limit_solver::task_nodes(entity_ref("urn:example:calculus:task"),entity_ref("urn:example:calculus:nodes")) { origin case_input; }
 assert "input-3": calc.limit_solver::task_function(entity_ref("urn:example:calculus:task"),7) { origin case_input; }
 assert "input-4": calc.limit_solver::task_variable(entity_ref("urn:example:calculus:task"),"x") { origin case_input; }
 assert "input-5": calc.limit_solver::task_approach(entity_ref("urn:example:calculus:task"),"at") { origin case_input; }
 assert "input-6": calc.limit_solver::task_point(entity_ref("urn:example:calculus:task"),1 / 1) { origin case_input; }
 assert "input-7": calc.limit_solver::task_side(entity_ref("urn:example:calculus:task"),"both") { origin case_input; }
 assert "input-8": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),1,"var","x",0 / 1,0,0) { origin case_input; }
 assert "input-9": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),2,"const","",2 / 1,0,0) { origin case_input; }
 assert "input-10": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),3,"pow","",0 / 1,1,2) { origin case_input; }
 assert "input-11": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),4,"const","",1 / 1,0,0) { origin case_input; }
 assert "input-12": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),5,"sub","",0 / 1,3,4) { origin case_input; }
 assert "input-13": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),6,"sub","",0 / 1,1,4) { origin case_input; }
 assert "input-14": calc.limit_solver::input_node(entity_ref("urn:example:calculus:task"),7,"div","",0 / 1,5,6) { origin case_input; }
 assert "input-15": calc.limit_solver::task_closed(entity_ref("urn:example:calculus:task")) { origin case_input; }

 }
 evaluate truth(automatic_limit_result(entity_ref("urn:example:calculus:task"),"FINITE","rational",2 / 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
