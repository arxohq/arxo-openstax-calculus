@source(CL_LHOPITAL_ZERO)
rule JustifyLhopital18(p: calc.calculus_checker::Derivation, i: Integer, r: LimitRule,
    f: Integer, j: Integer, k: Integer, l: Integer, approach: Text,
    point: Rational, side: Text, value_kind: Text, value: Integer, num: Integer, num_kind: Text, num_value: Integer) defeasible {
    label ru unofficial "проверенный шаг lhopital обоснован формулировкой учебника (§4 DECISION-0197)";
    when calc.calculus_checker::step_valid(p, i)
        and calc.calculus_checker::limit_line(p, i, f, "lhopital", j, k, l, approach, point, side, value_kind, value)
        and rule_method(r, "lhopital")
        and calc.calculus_checker::limit_result(p, j, num, approach, point, side, num_kind, num_value) and num_kind == "expr";
    then step_justified_by(p, i, r);
}

@source(CL_LHOPITAL_INFINITY)
rule JustifyLhopital19(p: calc.calculus_checker::Derivation, i: Integer, r: LimitRule,
    f: Integer, j: Integer, k: Integer, l: Integer, approach: Text,
    point: Rational, side: Text, value_kind: Text, value: Integer, num: Integer, num_kind: Text, num_value: Integer) defeasible {
    label ru unofficial "проверенный шаг lhopital обоснован формулировкой учебника (§4 DECISION-0197)";
    when calc.calculus_checker::step_valid(p, i)
        and calc.calculus_checker::limit_line(p, i, f, "lhopital", j, k, l, approach, point, side, value_kind, value)
        and rule_method(r, "lhopital")
        and calc.calculus_checker::limit_result(p, j, num, approach, point, side, num_kind, num_value) and num_kind != "expr";
    then step_justified_by(p, i, r);
}
