language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// DECISION-0197 §4: ожидания из закона и условий применимости.
test "Лопиталь: not-indeterminate" {
 given {
  assert "f0": document(entity_ref("urn:calc:limits:p"), 5, 7, "calculus/2") { origin case_input; }
  assert "f1": nodes_of(entity_ref("urn:calc:limits:p"), entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f2": variable(entity_ref("urn:calc:limits:p"), "x") { origin case_input; }
  assert "f3": closed(entity_ref("urn:calc:limits:p")) { origin case_input; }
  assert "f4": calc.expressions::closed(entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f5": calc.expressions::node(entity_ref("urn:calc:limits:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "f6": calc.expressions::node(entity_ref("urn:calc:limits:e"), 2, "const", "", 0 / 1, 0, 0) { origin case_input; }
  assert "f7": calc.expressions::node(entity_ref("urn:calc:limits:e"), 3, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "f8": calc.expressions::node(entity_ref("urn:calc:limits:e"), 4, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "f9": calc.expressions::node(entity_ref("urn:calc:limits:e"), 5, "sin", "", 0 / 1, 1, 0) { origin case_input; }
  assert "f10": calc.expressions::node(entity_ref("urn:calc:limits:e"), 6, "cos", "", 0 / 1, 1, 0) { origin case_input; }
  assert "f11": calc.expressions::node(entity_ref("urn:calc:limits:e"), 7, "div", "", 0 / 1, 5, 5) { origin case_input; }
  assert "f12": calc.expressions::node(entity_ref("urn:calc:limits:e"), 8, "div", "", 0 / 1, 6, 6) { origin case_input; }
  assert "f13": lhopital_derivatives(entity_ref("urn:calc:limits:p"), 5, 2, 2) { origin case_input; }
  assert "f14": nonzero_near(entity_ref("urn:calc:limits:p"), 5) { origin case_input; }
  assert "f15": line(entity_ref("urn:calc:limits:p"), 1, 5, "given", 0, 0, 0, 0) { origin case_input; }
  assert "f16": line(entity_ref("urn:calc:limits:p"), 2, 6, "derivative_sin", 1, 0, 0, 0) { origin case_input; }
  assert "f17": limit_line(entity_ref("urn:calc:limits:p"), 3, 5, "limit_given", 0, 0, 0, "at", 0 / 1, "both", "expr", 3) { origin case_input; }
  assert "f18": limit_line(entity_ref("urn:calc:limits:p"), 4, 8, "limit_given", 0, 0, 0, "at", 0 / 1, "both", "expr", 3) { origin case_input; }
  assert "f19": limit_line(entity_ref("urn:calc:limits:p"), 5, 7, "lhopital", 3, 3, 4, "at", 0 / 1, "both", "expr", 3) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:limits:p")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 evaluate truth(first_error(entity_ref("urn:calc:limits:p"), 5));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(step_error(entity_ref("urn:calc:limits:p"), 5, "NOT_INDETERMINATE"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(step_valid(entity_ref("urn:calc:limits:p"), 2));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
