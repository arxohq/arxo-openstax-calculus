language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// DECISION-0197 §4: ожидания из закона и условий применимости.
test "предел дроби на бесконечности: отказ" {
 given {
  assert "f0": document(entity_ref("urn:calc:limits:p"), 1, 4, "calculus/2") { origin case_input; }
  assert "f1": nodes_of(entity_ref("urn:calc:limits:p"), entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f2": variable(entity_ref("urn:calc:limits:p"), "x") { origin case_input; }
  assert "f3": closed(entity_ref("urn:calc:limits:p")) { origin case_input; }
  assert "f4": calc.expressions::closed(entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f5": calc.expressions::node(entity_ref("urn:calc:limits:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "f6": calc.expressions::node(entity_ref("urn:calc:limits:e"), 2, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "f7": calc.expressions::node(entity_ref("urn:calc:limits:e"), 3, "pow", "", 0 / 1, 1, 2) { origin case_input; }
  assert "f8": calc.expressions::node(entity_ref("urn:calc:limits:e"), 4, "div", "", 0 / 1, 3, 1) { origin case_input; }
  assert "f9": calc.polynomials_q::degree_cap(12) { origin case_input; }
  assert "f10": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 1, entity_ref("urn:calc:limits:poly1")) { origin case_input; }
  assert "f11": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 2, entity_ref("urn:calc:limits:poly2")) { origin case_input; }
  assert "f12": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 3, entity_ref("urn:calc:limits:poly3")) { origin case_input; }
  assert "f13": limit_line(entity_ref("urn:calc:limits:p"), 1, 4, "limit_at_infinity_rational", 0, 0, 0, "minus_inf", 0 / 1, "both", "plus_inf", 0) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:limits:p")));
 expect truth_status == NEITHER;
 expect evaluation_status == COMPUTED;
 evaluate truth(first_error(entity_ref("urn:calc:limits:p"), 1));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(step_error(entity_ref("urn:calc:limits:p"), 1, "RULE_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
