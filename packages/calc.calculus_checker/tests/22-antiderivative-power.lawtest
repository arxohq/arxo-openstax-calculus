language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// Первообразная степени: ∫x² dx = (1/3)·x³. Показатель растёт на один, множитель обратен новому показателю.

test "первообразная степени" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d1"), 2, 7, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d1"), entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d1"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 2, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 3, "pow", "", 0 / 1, 1, 2) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 4, "const", "", 1 / 3, 0, 0) { origin case_input; }
  assert "n5": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 5, "const", "", 3 / 1, 0, 0) { origin case_input; }
  assert "n6": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 6, "pow", "", 0 / 1, 1, 5) { origin case_input; }
  assert "n7": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 7, "mul", "", 0 / 1, 4, 6) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d1"), 1, 3, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d1"), 2, 7, "antiderivative_power", 1, 0, 0, 0) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d1")) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:cc:d1")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(AntiderivativePowerMatches);
}
