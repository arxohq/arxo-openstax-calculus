language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// Ссылка на ненаписанную строку: основание 5 не предъявлено.

test "ссылка на ненаписанную строку" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d1"), 2, 3, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d1"), entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d1"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 3, "cos", "", 0 / 1, 1, 0) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d1"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d1"), 2, 3, "derivative_sin", 5, 0, 0, 0) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d1")) { origin case_input; }
 }
 evaluate truth(step_error(entity_ref("urn:calc:cc:d1"), 2, "MISSING_REFERENCE"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(MissingReference);
}
