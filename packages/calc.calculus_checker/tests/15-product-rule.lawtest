language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// Правило произведения: (f·g)' = f'·g + f·g'. Сами f и g называет СТУДЕНТ полями aux.

test "правило произведения" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d1"), 3, 7, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d1"), entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d1"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 3, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 4, "cos", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n5": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 5, "mul", "", 0 / 1, 3, 2) { origin case_input; }
  assert "n6": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 6, "mul", "", 0 / 1, 1, 4) { origin case_input; }
  assert "n7": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 7, "add", "", 0 / 1, 5, 6) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d1"), 1, 3, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d1"), 2, 4, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l3": line(entity_ref("urn:calc:cc:d1"), 3, 7, "product_rule", 1, 2, 1, 2) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d1")) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:cc:d1")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ProductRuleMatches);
}
