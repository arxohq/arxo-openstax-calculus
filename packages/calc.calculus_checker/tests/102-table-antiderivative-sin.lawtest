language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// Таблица первообразных: ∫sin x dx = −cos x (седьмая строка таблицы
// Integration Formulas, m53621: d/dx(cos x) = −sin x).

test "таблица первообразных: синус" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d2"), 2, 4, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d2"), entity_ref("urn:calc:cc:e2")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d2"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e2"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e2"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e2"), 3, "cos", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:cc:e2"), 4, "neg", "", 0 / 1, 3, 0) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d2"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d2"), 2, 4, "table_antiderivative", 1, 0, 0, 0) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e2")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d2")) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:cc:d2")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(TableAntiderivativeSinMatches);
}
