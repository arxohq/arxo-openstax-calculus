language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// Тот же ход с ответом cos x без отрицания — таблица даёт −cos x.

test "таблица первообразных: синус без отрицания" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d3"), 2, 3, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d3"), entity_ref("urn:calc:cc:e3")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d3"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e3"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e3"), 2, "sin", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e3"), 3, "cos", "", 0 / 1, 1, 0) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d3"), 1, 2, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d3"), 2, 3, "table_antiderivative", 1, 0, 0, 0) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e3")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d3")) { origin case_input; }
 }
 evaluate truth(step_error(entity_ref("urn:calc:cc:d3"), 2, "RULE_MISMATCH"));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(RuleMismatch);
}
