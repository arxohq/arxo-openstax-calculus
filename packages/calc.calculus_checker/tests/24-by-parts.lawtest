language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// ∫x·e^x dx = x·e^x − e^x. Выбор u и dv сделал СТУДЕНТ и предъявил полями aux; Arxo его не делает никогда.

test "интегрирование по частям" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d1"), 4, 5, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d1"), entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d1"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 2, "exp", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 3, "mul", "", 0 / 1, 1, 2) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 4, "exp", "", 0 / 1, 1, 0) { origin case_input; }
  assert "n5": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 5, "sub", "", 0 / 1, 3, 4) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d1"), 1, 3, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d1"), 2, 2, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l3": line(entity_ref("urn:calc:cc:d1"), 3, 4, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l4": line(entity_ref("urn:calc:cc:d1"), 4, 5, "by_parts", 3, 2, 1, 2) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d1")) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:cc:d1")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(ByPartsMatches);
}
