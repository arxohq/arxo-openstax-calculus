language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// DECISION-0197 §4: ожидания из закона и условий применимости.
test "Лопиталь: многочленная производная True" {
 given {
  assert "f0": document(entity_ref("urn:calc:limits:p"), 5, 8, "calculus/2") { origin case_input; }
  assert "f1": nodes_of(entity_ref("urn:calc:limits:p"), entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f2": variable(entity_ref("urn:calc:limits:p"), "x") { origin case_input; }
  assert "f3": closed(entity_ref("urn:calc:limits:p")) { origin case_input; }
  assert "f4": calc.expressions::closed(entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f5": calc.expressions::node(entity_ref("urn:calc:limits:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "f6": calc.expressions::node(entity_ref("urn:calc:limits:e"), 2, "const", "", 0 / 1, 0, 0) { origin case_input; }
  assert "f7": calc.expressions::node(entity_ref("urn:calc:limits:e"), 3, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "f8": calc.expressions::node(entity_ref("urn:calc:limits:e"), 4, "pow", "", 0 / 1, 1, 3) { origin case_input; }
  assert "f9": calc.expressions::node(entity_ref("urn:calc:limits:e"), 5, "pow", "", 0 / 1, 1, 2) { origin case_input; }
  assert "f10": calc.expressions::node(entity_ref("urn:calc:limits:e"), 6, "mul", "", 0 / 1, 3, 5) { origin case_input; }
  assert "f11": calc.expressions::node(entity_ref("urn:calc:limits:e"), 7, "div", "", 0 / 1, 6, 6) { origin case_input; }
  assert "f12": calc.expressions::node(entity_ref("urn:calc:limits:e"), 8, "div", "", 0 / 1, 4, 4) { origin case_input; }
  assert "f13": lhopital_derivatives(entity_ref("urn:calc:limits:p"), 5, 2, 2) { origin case_input; }
  assert "f14": calc.polynomials_q::degree_cap(12) { origin case_input; }
  assert "f15": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 1, entity_ref("urn:calc:limits:poly1")) { origin case_input; }
  assert "f16": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 2, entity_ref("urn:calc:limits:poly2")) { origin case_input; }
  assert "f17": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 3, entity_ref("urn:calc:limits:poly3")) { origin case_input; }
  assert "f18": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 4, entity_ref("urn:calc:limits:poly4")) { origin case_input; }
  assert "f19": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 5, entity_ref("urn:calc:limits:poly5")) { origin case_input; }
  assert "f20": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:limits:e"), 6, entity_ref("urn:calc:limits:poly6")) { origin case_input; }
  assert "f21": line(entity_ref("urn:calc:limits:p"), 1, 4, "given", 0, 0, 0, 0) { origin case_input; }
  assert "f22": line(entity_ref("urn:calc:limits:p"), 2, 6, "power_rule", 1, 0, 0, 0) { origin case_input; }
  assert "f23": limit_line(entity_ref("urn:calc:limits:p"), 3, 4, "direct_substitution", 0, 0, 0, "at", 0 / 1, "both", "expr", 2) { origin case_input; }
  assert "f24": limit_line(entity_ref("urn:calc:limits:p"), 4, 7, "direct_substitution", 0, 0, 0, "at", 0 / 1, "both", "expr", 3) { origin case_input; }
  assert "f25": limit_line(entity_ref("urn:calc:limits:p"), 5, 8, "lhopital", 3, 3, 4, "at", 0 / 1, "both", "expr", 3) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:limits:p")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
