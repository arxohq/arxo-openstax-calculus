language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// algebra: обе стороны прочитаны как многочлены над ℚ, и их КАНОНЫ равны. Здесь равенство разрешимо, и шаг проверяется счётом.

test "algebra с равными канонами" {
 given {
  assert "d": document(entity_ref("urn:calc:cc:d1"), 2, 6, "calculus/1") { origin case_input; }
  assert "ctx": nodes_of(entity_ref("urn:calc:cc:d1"), entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "var": variable(entity_ref("urn:calc:cc:d1"), "x") { origin case_input; }
  assert "n1": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n2": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 2, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "n3": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 3, "add", "", 0 / 1, 1, 2) { origin case_input; }
  assert "n4": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 4, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "n5": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 5, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "n6": calc.expressions::node(entity_ref("urn:calc:cc:e1"), 6, "add", "", 0 / 1, 4, 5) { origin case_input; }
  assert "cap": calc.polynomials_q::degree_cap(8) { origin case_input; }
  assert "pv": calc.polynomials_q::polynomial_variable(entity_ref("urn:calc:cc:e1"), "x") { origin case_input; }
  assert "np1": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 1, entity_ref("urn:calc:cc:p1")) { origin case_input; }
  assert "np2": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 2, entity_ref("urn:calc:cc:p2")) { origin case_input; }
  assert "np3": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 3, entity_ref("urn:calc:cc:p3")) { origin case_input; }
  assert "np4": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 4, entity_ref("urn:calc:cc:p4")) { origin case_input; }
  assert "np5": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 5, entity_ref("urn:calc:cc:p5")) { origin case_input; }
  assert "np6": calc.polynomials_q::node_polynomial(entity_ref("urn:calc:cc:e1"), 6, entity_ref("urn:calc:cc:p6")) { origin case_input; }
  assert "cr": calc.polynomials_q::compare_request(entity_ref("urn:calc:cc:p6"), entity_ref("urn:calc:cc:p3")) { origin case_input; }
  assert "l1": line(entity_ref("urn:calc:cc:d1"), 1, 3, "given", 0, 0, 0, 0) { origin case_input; }
  assert "l2": line(entity_ref("urn:calc:cc:d1"), 2, 6, "algebra", 1, 0, 0, 0) { origin case_input; }
  assert "clx": calc.expressions::closed(entity_ref("urn:calc:cc:e1")) { origin case_input; }
  assert "clp": closed(entity_ref("urn:calc:cc:d1")) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:cc:d1")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 expect applied(AlgebraMatches);
}
