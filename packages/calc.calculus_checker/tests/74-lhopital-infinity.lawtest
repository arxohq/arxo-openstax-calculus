language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

// DECISION-0197 §4: ожидания из закона и условий применимости.
test "Лопиталь: infinity" {
 given {
  assert "f0": document(entity_ref("urn:calc:limits:p"), 5, 6, "calculus/2") { origin case_input; }
  assert "f1": nodes_of(entity_ref("urn:calc:limits:p"), entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f2": variable(entity_ref("urn:calc:limits:p"), "x") { origin case_input; }
  assert "f3": closed(entity_ref("urn:calc:limits:p")) { origin case_input; }
  assert "f4": calc.expressions::closed(entity_ref("urn:calc:limits:e")) { origin case_input; }
  assert "f5": calc.expressions::node(entity_ref("urn:calc:limits:e"), 1, "var", "x", 0 / 1, 0, 0) { origin case_input; }
  assert "f6": calc.expressions::node(entity_ref("urn:calc:limits:e"), 2, "const", "", 0 / 1, 0, 0) { origin case_input; }
  assert "f7": calc.expressions::node(entity_ref("urn:calc:limits:e"), 3, "const", "", 1 / 1, 0, 0) { origin case_input; }
  assert "f8": calc.expressions::node(entity_ref("urn:calc:limits:e"), 4, "const", "", 2 / 1, 0, 0) { origin case_input; }
  assert "f9": calc.expressions::node(entity_ref("urn:calc:limits:e"), 5, "exp", "", 0 / 1, 1, 0) { origin case_input; }
  assert "f10": calc.expressions::node(entity_ref("urn:calc:limits:e"), 6, "div", "", 0 / 1, 5, 5) { origin case_input; }
  assert "f11": calc.expressions::node(entity_ref("urn:calc:limits:e"), 7, "div", "", 0 / 1, 5, 5) { origin case_input; }
  assert "f12": lhopital_derivatives(entity_ref("urn:calc:limits:p"), 5, 2, 2) { origin case_input; }
  assert "f13": nonzero_near(entity_ref("urn:calc:limits:p"), 5) { origin case_input; }
  assert "f14": line(entity_ref("urn:calc:limits:p"), 1, 5, "given", 0, 0, 0, 0) { origin case_input; }
  assert "f15": line(entity_ref("urn:calc:limits:p"), 2, 5, "derivative_exp", 1, 0, 0, 0) { origin case_input; }
  assert "f16": limit_line(entity_ref("urn:calc:limits:p"), 3, 5, "limit_given", 0, 0, 0, "plus_inf", 0 / 1, "both", "plus_inf", 0) { origin case_input; }
  assert "f17": limit_line(entity_ref("urn:calc:limits:p"), 4, 7, "limit_given", 0, 0, 0, "plus_inf", 0 / 1, "both", "expr", 3) { origin case_input; }
  assert "f18": limit_line(entity_ref("urn:calc:limits:p"), 5, 6, "lhopital", 3, 3, 4, "plus_inf", 0 / 1, "both", "expr", 3) { origin case_input; }
 }
 evaluate truth(derivation_valid(entity_ref("urn:calc:limits:p")));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
 evaluate truth(step_valid(entity_ref("urn:calc:limits:p"), 2));
 expect truth_status == TRUE_ONLY;
 expect evaluation_status == COMPUTED;
}
