language "law.core" version "0.2";
package calc.calculus_checker version "0.1.0";
namespace "urn:law:calc:calculus-checker";

use self::{
    Derivation,
    active,
    checked,
    closed,
    context_of,
    document,
    line,
    line_present,
    local_match,
    required,
    step_error,
    unique_line,
};

// DECISION-0197 §4: предел — поля строки, а не новый тег выражения.
// Рекурсивные свидетельства положительны (§65/§103); отказы над ними.

pub relation limit_line(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }, f: Integer { label ru unofficial "f"; }, m: Text { label ru unofficial "m"; }, j: Integer { label ru unofficial "j"; }, k: Integer { label ru unofficial "k"; }, l: Integer { label ru unofficial "l"; }, ap: Text { label ru unofficial "ap"; }, a: Rational { label ru unofficial "a"; }, s: Text { label ru unofficial "s"; }, vk: Text { label ru unofficial "vk"; }, value: Integer { label ru unofficial "value"; }) kind empirical {
    label ru unofficial "строка предела: функция, метод, три основания, точка, сторона и значение";
}

pub relation lhopital_derivatives(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }, df: Integer { label ru unofficial "df"; }, dg: Integer { label ru unofficial "dg"; }) kind empirical {
    label ru unofficial "два номера строк производных для Лопиталя, названные студентом";
}

pub relation nonzero_near(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }) kind empirical {
    label ru unofficial "выбранное студентом условие: неполиномиальная производная знаменателя не обращается в ноль в окрестности";
}

pub relation limit_cancellation(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }, cancel: calc.polynomials_q::Cancellation { label ru unofficial "cancel"; }) kind empirical {
    label ru unofficial "явный запрос сокращения, используемый этой строкой";
}

relation limit_node(e: calc.expressions::Expr, f: Integer, tag: Text, name: Text, v: Rational, aa: Integer, bb: Integer) kind institutional {
    label ru unofficial "однозначный корректный узел, локальное представление unique_node без изменения expressions";
}

relation unique_limit(p: Derivation, i: Integer, f: Integer, m: Text, j: Integer, k: Integer, l: Integer, ap: Text, a: Rational, s: Text, vk: Text, value: Integer) kind institutional {
    label ru unofficial "единственная строка предела внутри общего диапазона";
}

relation limit_shape(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "поля предела допустимы";
}

relation limit_position(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "точка и сторона допустимы";
}

relation limit_value_shape(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "значение имеет допустимый вид";
}

pub relation limit_result(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }, f: Integer { label ru unofficial "f"; }, ap: Text { label ru unofficial "ap"; }, a: Rational { label ru unofficial "a"; }, s: Text { label ru unofficial "s"; }, vk: Text { label ru unofficial "vk"; }, value: Integer { label ru unofficial "value"; }) kind institutional {
    label ru unofficial "положительно установленный предел";
}

pub relation substituted(e: calc.expressions::Expr { label ru unofficial "e"; }, f: Integer { label ru unofficial "f"; }, value: Integer { label ru unofficial "value"; }, x: Text { label ru unofficial "x"; }, a: Rational { label ru unofficial "a"; }) kind institutional {
    label ru unofficial "дерево value равно f с заменой var x на const a";
}

relation limit_operand(p: Derivation, i: Integer, j: Integer, gj: Integer, vj: Integer) kind institutional {
    label ru unofficial "предшествующий конечный предел с той же точкой и стороной";
}

relation limit_pair(p: Derivation, i: Integer, j: Integer, gj: Integer, vkj: Text, vj: Integer) kind institutional {
    label ru unofficial "предшествующий предел с той же точкой и стороной";
}

relation limit_method_match(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "выполнены условия предъявленного метода";
}

relation limit_known_method(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "имя метода принадлежит calculus/2";
}

relation lhopital_indeterminate(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "предъявлены установленные пределы 0/0 либо бесконечность/бесконечность";
}

pub relation derivative_origin(p: Derivation { label ru unofficial "p"; }, i: Integer { label ru unofficial "i"; }, f: Integer { label ru unofficial "f"; }, gj: Integer { label ru unofficial "gj"; }) kind institutional {
    label ru unofficial "строка i устанавливает производную f исходной функции gj";
}

relation lhopital_derivative_pair(p: Derivation, i: Integer, df: Integer, dg: Integer, gj: Integer, gk: Integer) kind institutional {
    label ru unofficial "производные обеих исходных функций установлены";
}

relation lhopital_ratio(p: Derivation, i: Integer, vk: Text, value: Integer) kind institutional {
    label ru unofficial "предел отношения установленных производных";
}

relation lhopital_nonzero(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "условие ненулевой производной знаменателя установлено";
}

relation limit_same_value(e: calc.expressions::Expr, vkj: Text, vj: Integer, vkk: Text, vkkid: Integer) kind institutional {
    label ru unofficial "равенство значений предела";
}

relation limit_different_value(e: calc.expressions::Expr, vkj: Text, vj: Integer, vkk: Text, vkkid: Integer) kind institutional {
    label ru unofficial "доказанное различие конечных констант или видов бесконечности";
}

rule LimitNode(e: calc.expressions::Expr, tag: Text, name: Text, v: Rational, f: Integer, aa: Integer, bb: Integer) strict {
    label ru unofficial "локальное однозначное чтение дерева (§4 DECISION-0197)";
    when calc.expressions::node(e, f, tag, name, v, aa, bb) and calc.expressions::well_formed(e, f) and (count all m: Text for x: Text, c: Rational, j: Integer, k: Integer where calc.expressions::node(e, f, m, x, c, j, k)) == 1;
    then limit_node(e, f, tag, name, v, aa, bb);
}

rule LimitLinePresent(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "номер предела участвует в общем счётчике (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value);
    then line_present(p, i);
}

rule UniqueLimit(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, goal: Integer, n: Integer) strict {
    label ru unofficial "номер обозначает одну строку одного из двух видов (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and document(p, n, goal, "calculus/2") and active(p, n, goal) and i > 0 and i <= n and (count all gj: Integer for tag: Text, aj: Integer, bj: Integer, uj: Integer, name: Text, c: Rational, x: Text, sys: Text, dv: Integer where limit_line(p, i, gj, tag, aj, bj, uj, name, c, x, sys, dv)) == 1 and (count all gj: Integer for tag: Text, aj: Integer, bj: Integer, uj: Integer, dj: Integer where line(p, i, gj, tag, aj, bj, uj, dj)) == 0;
    then unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value);
}

rule LimitPositionatboth(p: Derivation, m: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "допустимые точка и сторона (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, "at", a, "both", vk, value);
    then limit_position(p, i);
}

rule LimitPositionatleft(p: Derivation, m: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "допустимые точка и сторона (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, "at", a, "left", vk, value);
    then limit_position(p, i);
}

rule LimitPositionatright(p: Derivation, m: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "допустимые точка и сторона (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, "at", a, "right", vk, value);
    then limit_position(p, i);
}

rule LimitPositionplus_infboth(p: Derivation, m: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "допустимые точка и сторона (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, "plus_inf", a, "both", vk, value) and a == 0 / 1;
    then limit_position(p, i);
}

rule LimitPositionminus_infboth(p: Derivation, m: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "допустимые точка и сторона (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, "minus_inf", a, "both", vk, value) and a == 0 / 1;
    then limit_position(p, i);
}

rule LimitExpressionValue(p: Derivation, e: calc.expressions::Expr, m: Text, ap: Text, s: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "конечное значение — корректное выражение (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, "expr", value) and context_of(p, e, x) and calc.expressions::well_formed(e, value);
    then limit_value_shape(p, i);
}

rule LimitValueplus_inf(p: Derivation, m: Text, ap: Text, s: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer) strict {
    label ru unofficial "при специальном виде поле узла равно нулю (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, "plus_inf", 0);
    then limit_value_shape(p, i);
}

rule LimitValueminus_inf(p: Derivation, m: Text, ap: Text, s: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer) strict {
    label ru unofficial "при специальном виде поле узла равно нулю (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, "minus_inf", 0);
    then limit_value_shape(p, i);
}

rule LimitValuedne(p: Derivation, m: Text, ap: Text, s: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer) strict {
    label ru unofficial "при специальном виде поле узла равно нулю (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, "dne", 0);
    then limit_value_shape(p, i);
}

rule LimitShape(p: Derivation, e: calc.expressions::Expr, m: Text, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "полная форма строки корректна (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and limit_position(p, i) and limit_value_shape(p, i) and context_of(p, e, x) and calc.expressions::well_formed(e, f);
    then limit_shape(p, i);
}

rule LimitRequiredj(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "основания предела входят в общую проверку ссылок (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and j > 0;
    then required(p, i, j);
}

rule LimitRequiredk(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "основания предела входят в общую проверку ссылок (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and k > 0;
    then required(p, i, k);
}

rule LimitRequiredl(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "основания предела входят в общую проверку ссылок (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and l > 0;
    then required(p, i, l);
}

rule LimitDerivativeRequireddf(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, df: Integer, dg: Integer) strict {
    label ru unofficial "производная является основанием строки (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and lhopital_derivatives(p, i, df, dg) and df > 0;
    then required(p, i, df);
}

rule LimitDerivativeRequireddg(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, df: Integer, dg: Integer) strict {
    label ru unofficial "производная является основанием строки (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and lhopital_derivatives(p, i, df, dg) and dg > 0;
    then required(p, i, dg);
}

rule LimitEstablished(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "метод установил предел в названной точке (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and limit_shape(p, i) and monotone(limit_method_match(p, i));
    then limit_result(p, i, f, ap, a, s, vk, value);
}

rule LimitChecked(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, value: Integer) strict {
    label ru unofficial "общий проверенный префикс включает пределы (§4 DECISION-0197)";
    when monotone(limit_result(p, i, f, ap, a, s, vk, value));
    then checked(p, i, f);
}

rule LimitLocalMatch(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, value: Integer) strict {
    label ru unofficial "проверенная форма предела (§4 DECISION-0197)";
    when monotone(limit_result(p, i, f, ap, a, s, vk, value));
    then local_match(p, i, f);
}

rule LimitPair(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, vkj: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, vj: Integer) strict {
    label ru unofficial "первое основание совпадает по точке и стороне (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and monotone(limit_result(p, j, gj, ap, a, s, vkj, vj)) and j > 0 and j < i;
    then limit_pair(p, i, j, gj, vkj, vj);
}

rule LimitPairk(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, vkj: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, vj: Integer) strict {
    label ru unofficial "предшествующее основание с той же точкой и стороной (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and monotone(limit_result(p, k, gj, ap, a, s, vkj, vj)) and k > 0 and k < i;
    then limit_pair(p, i, k, gj, vkj, vj);
}

rule LimitPairl(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, vkj: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, vj: Integer) strict {
    label ru unofficial "предшествующее основание с той же точкой и стороной (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and monotone(limit_result(p, l, gj, ap, a, s, vkj, vj)) and l > 0 and l < i;
    then limit_pair(p, i, l, gj, vkj, vj);
}

rule LimitFiniteOperand(p: Derivation, i: Integer, j: Integer, gj: Integer, vj: Integer) strict {
    label ru unofficial "конечный предел основания (§4 DECISION-0197)";
    when monotone(limit_pair(p, i, j, gj, "expr", vj));
    then limit_operand(p, i, j, gj, vj);
}

rule LimitKnownLimitGiven(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_given", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitConstant(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_constant", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitIdentity(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_identity", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitSum(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_sum", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitDifference(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_difference", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitProduct(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_product", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitConstantMultiple(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_constant_multiple", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitPower(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_power", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownLimitQuotient(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_quotient", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownDirectSubstitution(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "direct_substitution", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownFactorAndCancel(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "factor_and_cancel", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownContinuity(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "continuity", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownSpecialLimitSin(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "special_limit_sin", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownSpecialLimitOneMinusCos(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "special_limit_one_minus_cos", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

rule LimitKnownOneSidedAgree(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "закрытый словарь методов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "one_sided_agree", j, k, l, ap, a, s, vk, value);
    then limit_known_method(p, i);
}

