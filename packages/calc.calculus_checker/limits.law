    then derivative_origin(p, i, f, gj);
}

rule DerivativeOriginderivative_ln(p: Derivation, e: calc.expressions::Expr, x: Text, i: Integer, f: Integer, j: Integer, gj: Integer) strict {
    label ru unofficial "происхождение проверенной производной от исходной функции (§4 DECISION-0197)";
    when unique_line(p, i, f, "derivative_ln", j, 0, 0, 0) and unique_line(p, j, gj, "given", 0, 0, 0, 0) and monotone(checked(p, i, f)) and monotone(checked(p, j, gj)) and context_of(p, e, x) and calc.expressions::well_formed(e, f) and calc.expressions::well_formed(e, gj) and j > 0 and j < i;
    then derivative_origin(p, i, f, gj);
}

rule DerivativeOriginalgebra(p: Derivation, i: Integer, f: Integer, j: Integer, gj: Integer, gk: Integer) strict {
    label ru unofficial "преобразование сохраняет исходник производной (§4 DECISION-0197)";
    when unique_line(p, i, f, "algebra", j, 0, 0, 0) and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, gk)) and j > 0 and j < i;
    then derivative_origin(p, i, f, gk);
}

rule DerivativeOriginidentity(p: Derivation, i: Integer, f: Integer, j: Integer, gj: Integer, gk: Integer) strict {
    label ru unofficial "преобразование сохраняет исходник производной (§4 DECISION-0197)";
    when unique_line(p, i, f, "identity", j, 0, 0, 0) and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, gk)) and j > 0 and j < i;
    then derivative_origin(p, i, f, gk);
}

rule LhopitalZeroOverZero(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, vkj: Text, vkk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer) strict {
    label ru unofficial "неопределённость 0/0 из двух установленных пределов (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and monotone(limit_pair(p, i, j, gj, vkj, vj)) and monotone(limit_pair(p, i, k, gk, vkk, vkkid)) and calc.expressions::equivalent(e, aa, gj) and calc.expressions::equivalent(e, bb, gk) and vkj == "expr" and vkk == "expr" and limit_node(e, vj, "const", "", 0 / 1, 0, 0) and limit_node(e, vkkid, "const", "", 0 / 1, 0, 0);
    then lhopital_indeterminate(p, i);
}

rule LhopitalInfinityplus_infplus_inf(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, vkj: Text, vkk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer) strict {
    label ru unofficial "неопределённость ∞/∞ независимо от знаков (§4 DECISION-0197)";
