}

rule Checklimit_quotient(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "закон пределов проверяет структуру функции и результата (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_quotient", j, k, 0, ap, a, s, "expr", value) and context_of(p, e, x) and monotone(limit_operand(p, i, j, gj, vj)) and monotone(limit_operand(p, i, k, gk, vkkid)) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.expressions::equivalent(e, aa, gj) and calc.expressions::equivalent(e, bb, gk) and limit_node(e, value, "div", "", 0 / 1, cc, dd) and calc.expressions::equivalent(e, cc, vj) and calc.expressions::equivalent(e, dd, vkkid) and limit_node(e, vkkid, "const", "", c, 0, 0) and c != 0 / 1;
    then limit_method_match(p, i);
}

rule LimitConstantMultiple(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, j: Integer, value: Integer, gj: Integer, vj: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "сохранены постоянный множитель и предел второго множителя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_constant_multiple", j, 0, 0, ap, a, s, "expr", value) and context_of(p, e, x) and monotone(limit_operand(p, i, j, gj, vj)) and limit_node(e, f, "mul", "", 0 / 1, aa, bb) and limit_node(e, aa, "const", "", c, 0, 0) and calc.expressions::equivalent(e, bb, gj) and limit_node(e, value, "mul", "", 0 / 1, cc, dd) and calc.expressions::equivalent(e, aa, cc) and calc.expressions::equivalent(e, vj, dd);
    then limit_method_match(p, i);
}

rule LimitPower(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, j: Integer, value: Integer, gj: Integer, vj: Integer, en: Integer, aa: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "степень — положительный целый показатель корректного дерева (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_power", j, 0, 0, ap, a, s, "expr", value) and context_of(p, e, x) and monotone(limit_operand(p, i, j, gj, vj)) and limit_node(e, f, "pow", "", 0 / 1, aa, en) and limit_node(e, en, "const", "", c, 0, 0) and c > 0 / 1 and calc.expressions::equivalent(e, aa, gj) and limit_node(e, value, "pow", "", 0 / 1, cc, dd) and calc.expressions::equivalent(e, cc, vj) and calc.expressions::equivalent(e, dd, en);
    then limit_method_match(p, i);
}

rule SubstituteVariable(p: Derivation, gk: Integer, e: calc.expressions::Expr, m: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer) strict {
    label ru unofficial "заменить только названную переменную (§4 DECISION-0197)";
    when context_of(p, e, x) and unique_limit(p, i, f, m, j, k, l, "at", a, s, vk, value) and limit_node(e, gj, "var", x, 0 / 1, 0, 0) and limit_node(e, gk, "const", "", a, 0, 0);
    then substituted(e, gj, gk, x, a);
}

rule SubstituteConstant(p: Derivation, gk: Integer, e: calc.expressions::Expr, m: Text, s: Text, vk: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer) strict {
    label ru unofficial "константа сохраняется (§4 DECISION-0197)";
    when context_of(p, e, x) and unique_limit(p, i, f, m, j, k, l, "at", a, s, vk, value) and limit_node(e, gj, "const", "", c, 0, 0) and limit_node(e, gk, "const", "", c, 0, 0);
    then substituted(e, gj, gk, x, a);
}

rule SubstituteOtherVariable(p: Derivation, gk: Integer, e: calc.expressions::Expr, m: Text, s: Text, vk: Text, x: Text, name: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer) strict {
    label ru unofficial "чужая переменная сохраняется (§4 DECISION-0197)";
    when context_of(p, e, x) and unique_limit(p, i, f, m, j, k, l, "at", a, s, vk, value) and limit_node(e, gj, "var", name, 0 / 1, 0, 0) and name != x and limit_node(e, gk, "var", name, 0 / 1, 0, 0);
    then substituted(e, gj, gk, x, a);
}

