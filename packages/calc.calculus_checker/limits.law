rule ContinuousTreeLnVariable(e: calc.expressions::Expr, f: Integer, x: Text, a: Rational, aa: Integer) strict {
 label ru unofficial "логарифм непрерывен при положительной точке (§4 DECISION-0197)";
 when limit_node(e, f, "ln", "", 0 / 1, aa, 0) and limit_node(e, aa, "var", x, 0 / 1, 0, 0)
  and monotone(continuous_tree(e, aa, x, a)) and a > 0 / 1;
 then continuous_tree(e, f, x, a);
}
rule ContinuousTreeLnConstant(e: calc.expressions::Expr, f: Integer, x: Text, a: Rational, aa: Integer, c: Rational) strict {
 label ru unofficial "логарифм положительной константы непрерывен (§4 DECISION-0197)";
 when limit_node(e, f, "ln", "", 0 / 1, aa, 0) and limit_node(e, aa, "const", "", c, 0, 0)
  and monotone(continuous_tree(e, aa, x, a)) and c > 0 / 1;
 then continuous_tree(e, f, x, a);
}

// §4 DECISION-0197: происхождение сложной производной сверяется с given.
rule DerivativeOriginsum_rule(p: Derivation, e: calc.expressions::Expr, x: Text,
 i: Integer, f: Integer, j: Integer, k: Integer, pos: Integer, original: Integer,
 gj: Integer, gk: Integer, fj: Integer, fk: Integer, aa: Integer, bb: Integer) strict {
 label ru unofficial "исходник производной sum_rule совпадает с предъявленной функцией (§4 DECISION-0197)";
 when unique_line(p, i, f, "sum_rule", j, k, 0, 0)
  and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, fj))
  and monotone(derivative_origin(p, k, gk, fk))
  and unique_line(p, pos, original, "given", 0, 0, 0, 0)
  and monotone(checked(p, pos, original)) and pos < i and j < i and k < i
  and context_of(p, e, x) and limit_node(e, original, "add", "", 0 / 1, aa, bb)
  and calc.expressions::equivalent(e, aa, fj) and calc.expressions::equivalent(e, bb, fk);
 then derivative_origin(p, i, f, original);
}

// §4 DECISION-0197: происхождение сложной производной сверяется с given.
rule DerivativeOriginproduct_rule(p: Derivation, e: calc.expressions::Expr, x: Text,
 i: Integer, f: Integer, j: Integer, k: Integer, pos: Integer, original: Integer,
 gj: Integer, gk: Integer, fj: Integer, fk: Integer, aa: Integer, bb: Integer, u: Integer, dv: Integer) strict {
 label ru unofficial "исходник производной product_rule совпадает с предъявленной функцией (§4 DECISION-0197)";
 when unique_line(p, i, f, "product_rule", j, k, u, dv)
  and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, fj))
  and monotone(derivative_origin(p, k, gk, fk))
  and unique_line(p, pos, original, "given", 0, 0, 0, 0)
  and monotone(checked(p, pos, original)) and pos < i and j < i and k < i
  and context_of(p, e, x) and limit_node(e, original, "mul", "", 0 / 1, aa, bb)
  and calc.expressions::equivalent(e, aa, fj) and calc.expressions::equivalent(e, bb, fk) and calc.expressions::equivalent(e, u, fj) and calc.expressions::equivalent(e, dv, fk);
 then derivative_origin(p, i, f, original);
}

// §4 DECISION-0197: происхождение сложной производной сверяется с given.
rule DerivativeOriginquotient_rule(p: Derivation, e: calc.expressions::Expr, x: Text,
 i: Integer, f: Integer, j: Integer, k: Integer, pos: Integer, original: Integer,
 gj: Integer, gk: Integer, fj: Integer, fk: Integer, aa: Integer, bb: Integer, u: Integer, dv: Integer) strict {
 label ru unofficial "исходник производной quotient_rule совпадает с предъявленной функцией (§4 DECISION-0197)";
 when unique_line(p, i, f, "quotient_rule", j, k, u, dv)
  and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, fj))
  and monotone(derivative_origin(p, k, gk, fk))
  and unique_line(p, pos, original, "given", 0, 0, 0, 0)
  and monotone(checked(p, pos, original)) and pos < i and j < i and k < i
  and context_of(p, e, x) and limit_node(e, original, "div", "", 0 / 1, aa, bb)
  and calc.expressions::equivalent(e, aa, fj) and calc.expressions::equivalent(e, bb, fk) and calc.expressions::equivalent(e, u, fj) and calc.expressions::equivalent(e, dv, fk);
 then derivative_origin(p, i, f, original);
}

rule DerivativeOriginConstantMultiple(p: Derivation, e: calc.expressions::Expr, x: Text,
 i: Integer, f: Integer, j: Integer, pos: Integer, original: Integer,
 gj: Integer, fj: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer, c: Rational) strict {
 label ru unofficial "исходник производной постоянного множителя совпадает с given (§4 DECISION-0197)";
 when unique_line(p, i, f, "constant_multiple", j, 0, 0, 0)
  and monotone(checked(p, i, f)) and monotone(derivative_origin(p, j, gj, fj))
  and unique_line(p, pos, original, "given", 0, 0, 0, 0)
  and monotone(checked(p, pos, original)) and pos < i and j < i
  and context_of(p, e, x) and limit_node(e, original, "mul", "", 0 / 1, aa, bb)
  and limit_node(e, f, "mul", "", 0 / 1, cc, dd)
  and limit_node(e, aa, "const", "", c, 0, 0)
  and calc.expressions::equivalent(e, aa, cc) and calc.expressions::equivalent(e, bb, fj);
 then derivative_origin(p, i, f, original);
}
