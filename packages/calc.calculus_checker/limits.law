    when unique_limit(p, i, f, "limit_identity", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and limit_node(e, f, "var", x, 0 / 1, 0, 0) and limit_node(e, value, "const", "", a, 0, 0);
    then limit_method_match(p, i);
}

rule LimitIdentityplus_inf(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer) strict {
