rule LimitGiven(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, value: Integer) strict {
    label ru unofficial "предел предъявлен как посылка дела (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_given", 0, 0, 0, ap, a, s, vk, value);
    then limit_method_match(p, i);
}

rule LimitConstant(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, value: Integer) strict {
    label ru unofficial "предел константы равен ей самой (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_constant", 0, 0, 0, ap, a, s, "expr", value) and context_of(p, e, x) and limit_node(e, f, "const", "", c, 0, 0) and calc.expressions::equivalent(e, f, value);
    then limit_method_match(p, i);
}

rule LimitIdentityAt(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer) strict {
