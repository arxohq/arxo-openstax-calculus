rule Continuitysin(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer) strict {
    label ru unofficial "непрерывная элементарная функция, точная структурная подстановка (§4 DECISION-0197)";
    when unique_limit(p, i, f, "continuity", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and limit_node(e, f, "sin", "", 0 / 1, aa, 0) and continuous_tree(e, f, x, a) and substituted(e, f, value, x, a);
    then limit_method_match(p, i);
}

