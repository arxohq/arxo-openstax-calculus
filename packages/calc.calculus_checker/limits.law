    then lhopital_indeterminate(p, i);
}

rule LhopitalDerivativePair(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "обе производные установлены для исходных числителя и знаменателя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and lhopital_derivatives(p, i, df, dg) and df > 0 and dg > 0 and df < i and dg < i and (count all aj: Integer for bj: Integer where lhopital_derivatives(p, i, aj, bj)) == 1 and monotone(derivative_origin(p, df, gj, cc)) and monotone(derivative_origin(p, dg, gk, dd)) and calc.expressions::equivalent(e, aa, cc) and calc.expressions::equivalent(e, bb, dd);
    then lhopital_derivative_pair(p, i, df, dg, gj, gk);
}

rule LhopitalRatioLimit(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, vkl: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, gl: Integer, vl: Integer, df: Integer, dg: Integer, aa: Integer, bb: Integer) strict {
    label ru unofficial "основание устанавливает предел отношения именно этих производных (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and monotone(limit_pair(p, i, l, gl, vkl, vl)) and limit_node(e, gl, "div", "", 0 / 1, aa, bb) and calc.expressions::equivalent(e, aa, gj) and calc.expressions::equivalent(e, bb, gk) and vkl != "dne";
    then lhopital_ratio(p, i, vkl, vl);
}

rule LhopitalAskNonzero(p: Derivation, tag: Text, aj: Integer, bj: Integer, uj: Integer, dj: Integer, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gk: Integer, df: Integer, dg: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "вычислить производную знаменателя в точке (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and lhopital_derivatives(p, i, df, dg) and line(p, dg, gk, tag, aj, bj, uj, dj) and calc.polynomials_q::polynomial_of(e, gk, x, pp) and ap == "at";
    then calc.polynomials_q::evaluation_request(pp, a);
}

rule LhopitalPolynomialNonzeroAt(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, v: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "ненулевое значение многочлена в точке (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and calc.polynomials_q::polynomial_of(e, gk, x, pp) and ap == "at" and calc.polynomials_q::poly_value(pp, a, v) and v != 0 / 1;
    then lhopital_nonzero(p, i);
}

rule LhopitalPolynomialNonzeroplus_inf(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, n: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "ненулевой многочлен не обращается в ноль достаточно далеко (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and calc.polynomials_q::polynomial_of(e, gk, x, pp) and ap == "plus_inf" and calc.polynomials_q::degree(pp, n);
    then lhopital_nonzero(p, i);
}

rule LhopitalPolynomialNonzerominus_inf(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, n: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "ненулевой многочлен не обращается в ноль достаточно далеко (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and calc.polynomials_q::polynomial_of(e, gk, x, pp) and ap == "minus_inf" and calc.polynomials_q::degree(pp, n);
    then lhopital_nonzero(p, i);
}

rule LhopitalStudentNonzero(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer) strict {
    label ru unofficial "факт студента для неполиномиальной производной (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and calc.polynomials_q::not_polynomial(e, gk) and nonzero_near(p, i);
    then lhopital_nonzero(p, i);
}

rule LhopitalMatch(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, vkl: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gj: Integer, gk: Integer, vl: Integer, df: Integer, dg: Integer) strict {
    label ru unofficial "все пять оснований и условие ненулевой производной проверены (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(lhopital_indeterminate(p, i)) and monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk)) and monotone(lhopital_ratio(p, i, vkl, vl)) and monotone(lhopital_nonzero(p, i)) and limit_same_value(e, vk, value, vkl, vl);
    then limit_method_match(p, i);
}

rule LimitInvalidIndex(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "неположительный номер строки (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and i <= 0;
    then step_error(p, i, "INVALID_INDEX");
}

rule LimitExtraLine(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, goal: Integer, n: Integer) strict {
    label ru unofficial "строка после объявленного конца (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and active(p, n, goal) and i > n;
    then step_error(p, i, "EXTRA_LINE");
}

rule LimitDuplicate(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "два предела с одним номером (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and (count all gj: Integer for tag: Text, aj: Integer, bj: Integer, uj: Integer, name: Text, c: Rational, x: Text, sys: Text, dv: Integer where limit_line(p, i, gj, tag, aj, bj, uj, name, c, x, sys, dv)) > 1;
    then step_error(p, i, "AMBIGUOUS_LINE");
}

rule LimitMixedDuplicate(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "предел и производная заняли один номер (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and (count all gj: Integer for tag: Text, aj: Integer, bj: Integer, uj: Integer, dj: Integer where line(p, i, gj, tag, aj, bj, uj, dj)) > 0;
    then step_error(p, i, "AMBIGUOUS_LINE");
}

rule LimitUnknownMethod(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "неизвестный метод предела (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and closed(p) and not_known(limit_known_method(p, i));
    then step_error(p, i, "UNKNOWN_METHOD");
}

rule LimitBadShape(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "недопустимые поля строки предела (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and closed(p) and not_known(limit_shape(p, i));
    then step_error(p, i, "INVALID_LIMIT_FIELDS");
}

relation lhopital_has_derivatives(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "наличие проверенного свидетельства derivatives";
}

rule LhopitalHasderivatives(p: Derivation, i: Integer, gj: Integer, gk: Integer, df: Integer, dg: Integer) strict {
    label ru unofficial "проекция существования свидетельства (§4 DECISION-0197)";
    when monotone(lhopital_derivative_pair(p, i, df, dg, gj, gk));
    then lhopital_has_derivatives(p, i);
}

relation lhopital_has_ratio(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "наличие проверенного свидетельства ratio";
}

rule LhopitalHasratio(p: Derivation, vkl: Text, i: Integer, vl: Integer) strict {
    label ru unofficial "проекция существования свидетельства (§4 DECISION-0197)";
    when monotone(lhopital_ratio(p, i, vkl, vl));
    then lhopital_has_ratio(p, i);
}

rule LhopitalErrorNOT_INDETERMINATE(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "названо отсутствующее условие Лопиталя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and closed(p) and not_known(lhopital_indeterminate(p, i));
    then step_error(p, i, "NOT_INDETERMINATE");
}

rule LhopitalErrorDERIVATIVE_NOT_ESTABLISHED(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "названо отсутствующее условие Лопиталя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and closed(p) and monotone(lhopital_indeterminate(p, i)) and not_known(lhopital_has_derivatives(p, i));
    then step_error(p, i, "DERIVATIVE_NOT_ESTABLISHED");
}

rule LhopitalErrorRATIO_LIMIT_NOT_ESTABLISHED(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "названо отсутствующее условие Лопиталя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and closed(p) and monotone(lhopital_indeterminate(p, i)) and lhopital_has_derivatives(p, i) and not_known(lhopital_has_ratio(p, i));
    then step_error(p, i, "RATIO_LIMIT_NOT_ESTABLISHED");
}

rule LhopitalErrorNONZERO_NEAR_NOT_ESTABLISHED(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "названо отсутствующее условие Лопиталя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and closed(p) and monotone(lhopital_indeterminate(p, i)) and lhopital_has_derivatives(p, i) and lhopital_has_ratio(p, i) and not_known(lhopital_nonzero(p, i));
    then step_error(p, i, "NONZERO_NEAR_NOT_ESTABLISHED");
}

relation quotient_nonzero_limit(p: Derivation, i: Integer) kind institutional {
    label ru unofficial "предел знаменателя — ненулевая рациональная константа";
}

rule QuotientNonzeroLimit(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, c: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, gk: Integer, vkkid: Integer) strict {
    label ru unofficial "ненулевой конечный предел знаменателя (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_quotient", j, k, l, ap, a, s, vk, value) and context_of(p, e, x) and monotone(limit_operand(p, i, k, gk, vkkid)) and limit_node(e, vkkid, "const", "", c, 0, 0) and c != 0 / 1;
    then quotient_nonzero_limit(p, i);
}

rule QuotientLimitError(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "условие закона частного отсутствует (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_quotient", j, k, l, ap, a, s, vk, value) and closed(p) and not_known(quotient_nonzero_limit(p, i));
    then step_error(p, i, "DENOMINATOR_LIMIT_NOT_NONZERO");
}

rule LimitRuleMismatch(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "метод не установил предъявленный предел (§4 DECISION-0197)";
    when unique_limit(p, i, f, m, j, k, l, ap, a, s, vk, value) and closed(p) and m != "lhopital" and m != "limit_quotient" and not_known(limit_method_match(p, i));
    then step_error(p, i, "RULE_MISMATCH");
}

rule LhopitalResultMismatch(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "результат отличается от предела отношения производных (§4 DECISION-0197)";
    when unique_limit(p, i, f, "lhopital", j, k, l, ap, a, s, vk, value) and closed(p) and monotone(lhopital_indeterminate(p, i)) and lhopital_has_derivatives(p, i) and lhopital_has_ratio(p, i) and monotone(lhopital_nonzero(p, i)) and not_known(limit_method_match(p, i));
    then step_error(p, i, "RULE_MISMATCH");
}

rule QuotientResultMismatch(p: Derivation, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) defeasible {
    label ru unofficial "форма частного или его результата не совпала (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_quotient", j, k, l, ap, a, s, vk, value) and closed(p) and quotient_nonzero_limit(p, i) and not_known(limit_method_match(p, i));
    then step_error(p, i, "RULE_MISMATCH");
}

rule LimitGivenInOldCalculus(p: Derivation, m: Text, ap: Text, s: Text, vk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer, goal: Integer, n: Integer) strict {
    label ru unofficial "пределы требуют нового словаря (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and document(p, n, goal, "calculus/1");
    then step_error(p, i, "LIMIT_REQUIRES_CALCULUS_2");
}

// §4 DECISION-0197: сравнение канонов тоже требует ЯВНОГО запроса.
// Запрос зависит от предъявленных дескрипторов, не от результата проверки.
rule CancellationRequestsNumeratorComparison(
 p: Derivation, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer,
 ap: Text, a: Rational, s: Text, vk: Text, value: Integer,
 gj: Integer, m: Text, aj: Integer, bj: Integer, uj: Integer,
 apj: Text, ajpoint: Rational, sj: Text, vkj: Text, vj: Integer,
 e: calc.expressions::Expr, x: Text, aa: Integer, bb: Integer,
 cancel: calc.polynomials_q::Cancellation, factor: calc.polynomials_q::Poly,
 dn: calc.polynomials_q::Division, dd: calc.polynomials_q::Division,
 qn: calc.polynomials_q::Poly, rn: calc.polynomials_q::Poly,
 qd: calc.polynomials_q::Poly, rd: calc.polynomials_q::Poly,
 pp: calc.polynomials_q::Poly
) strict {
 label ru unofficial "запрос сличения числителей сокращённой дроби (§4 DECISION-0197)";
 when limit_line(p, i, f, "factor_and_cancel", j, k, l, ap, a, s, vk, value)
  and limit_line(p, j, gj, m, aj, bj, uj, apj, ajpoint, sj, vkj, vj)
  and context_of(p, e, x) and limit_node(e, gj, "div", "", 0 / 1, aa, bb)
  and limit_cancellation(p, i, cancel)
  and calc.polynomials_q::cancellation_workspace(cancel, factor, dn, dd, qn, rn, qd, rd)
  and calc.polynomials_q::polynomial_of(e, aa, x, pp);
 then calc.polynomials_q::compare_request(qn, pp);
}

rule CancellationRequestsDenominatorComparison(
 p: Derivation, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer,
 ap: Text, a: Rational, s: Text, vk: Text, value: Integer,
 gj: Integer, m: Text, aj: Integer, bj: Integer, uj: Integer,
 apj: Text, ajpoint: Rational, sj: Text, vkj: Text, vj: Integer,
 e: calc.expressions::Expr, x: Text, aa: Integer, bb: Integer,
 cancel: calc.polynomials_q::Cancellation, factor: calc.polynomials_q::Poly,
 dn: calc.polynomials_q::Division, dd: calc.polynomials_q::Division,
 qn: calc.polynomials_q::Poly, rn: calc.polynomials_q::Poly,
 qd: calc.polynomials_q::Poly, rd: calc.polynomials_q::Poly,
 pp: calc.polynomials_q::Poly
) strict {
 label ru unofficial "запрос сличения знаменателей сокращённой дроби (§4 DECISION-0197)";
 when limit_line(p, i, f, "factor_and_cancel", j, k, l, ap, a, s, vk, value)
  and limit_line(p, j, gj, m, aj, bj, uj, apj, ajpoint, sj, vkj, vj)
  and context_of(p, e, x) and limit_node(e, gj, "div", "", 0 / 1, aa, bb)
  and limit_cancellation(p, i, cancel)
  and calc.polynomials_q::cancellation_workspace(cancel, factor, dn, dd, qn, rn, qd, rd)
  and calc.polynomials_q::polynomial_of(e, bb, x, pp);
 then calc.polynomials_q::compare_request(qd, pp);
}

// §4 DECISION-0197: вычислительные отказы сохраняют собственное имя.
rule LimitRationalComputationError(
 p: Derivation, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer,
 ap: Text, a: Rational, s: Text, vk: Text, value: Integer,
 e: calc.expressions::Expr, x: Text, aa: Integer, bb: Integer,
 pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly, reason: Text
) strict {
 label ru unofficial "названный отказ подстановки дроби (§4 DECISION-0197)";
 when limit_line(p, i, f, "direct_substitution", j, k, l, ap, a, s, vk, value)
  and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb)
  and calc.polynomials_q::polynomial_of(e, aa, x, pn)
  and calc.polynomials_q::polynomial_of(e, bb, x, pd)
  and calc.polynomials_q::rational_value_error(pn, pd, a, reason);
 then step_error(p, i, reason);
}
rule LimitCancellationComputationError(
 p: Derivation, i: Integer, cancel: calc.polynomials_q::Cancellation, reason: Text
) strict {
 label ru unofficial "названный отказ сокращения (§4 DECISION-0197)";
 when limit_cancellation(p, i, cancel) and calc.polynomials_q::cancellation_error(cancel, reason);
 then step_error(p, i, reason);
}

rule LimitInfinityComputationError(
 p: Derivation, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer,
 ap: Text, a: Rational, s: Text, vk: Text, value: Integer,
 e: calc.expressions::Expr, x: Text, aa: Integer, bb: Integer,
 pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly, reason: Text
) strict {
 label ru unofficial "названный отказ предела дроби на бесконечности (§4 DECISION-0197)";
 when limit_line(p, i, f, "limit_at_infinity_rational", j, k, l, ap, a, s, vk, value)
  and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb)
  and calc.polynomials_q::polynomial_of(e, aa, x, pn)
  and calc.polynomials_q::polynomial_of(e, bb, x, pd)
  and calc.polynomials_q::infinity_limit_error(pn, pd, ap, reason);
 then step_error(p, i, reason);
}

relation continuous_tree(e: calc.expressions::Expr, f: Integer, x: Text, a: Rational) kind institutional {
 label ru unofficial "положительное свидетельство непрерывности дерева в рациональной точке";
}
rule ContinuousVariable(p: Derivation, e: calc.expressions::Expr, x: Text, a: Rational,
 i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, s: Text, value: Integer, gj: Integer) strict {
 label ru unofficial "переменная непрерывна (§4 DECISION-0197)";
 when unique_limit(p, i, f, "continuity", j, k, l, "at", a, s, "expr", value)
  and context_of(p, e, x) and limit_node(e, gj, "var", x, 0 / 1, 0, 0);
 then continuous_tree(e, gj, x, a);
}
rule ContinuousConstant(p: Derivation, e: calc.expressions::Expr, x: Text, a: Rational,
 i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, s: Text, value: Integer, gj: Integer, c: Rational) strict {
 label ru unofficial "константа непрерывна (§4 DECISION-0197)";
 when unique_limit(p, i, f, "continuity", j, k, l, "at", a, s, "expr", value)
  and context_of(p, e, x) and limit_node(e, gj, "const", "", c, 0, 0);
 then continuous_tree(e, gj, x, a);
}

rule ContinuousTreesin(e: calc.expressions::Expr, f: Integer, x: Text, a: Rational, aa: Integer) strict {
 label ru unofficial "композиция непрерывных функций sin (§4 DECISION-0197)";
 when limit_node(e, f, "sin", "", 0 / 1, aa, 0) and monotone(continuous_tree(e, aa, x, a));
 then continuous_tree(e, f, x, a);
}

rule ContinuousTreecos(e: calc.expressions::Expr, f: Integer, x: Text, a: Rational, aa: Integer) strict {
