rule Checkspecial_limit_sin(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, cc: Integer) strict {
    label ru unofficial "специальный тригонометрический предел в нуле (§4 DECISION-0197)";
    when unique_limit(p, i, f, "special_limit_sin", 0, 0, 0, "at", a, s, "expr", value) and a == 0 / 1 and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and limit_node(e, bb, "var", x, 0 / 1, 0, 0) and limit_node(e, value, "const", "", 1 / 1, 0, 0) and limit_node(e, aa, "sin", "", 0 / 1, cc, 0) and calc.expressions::equivalent(e, cc, bb);
    then limit_method_match(p, i);
}

rule Checkspecial_limit_one_minus_cos(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, en: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "специальный тригонометрический предел в нуле (§4 DECISION-0197)";
    when unique_limit(p, i, f, "special_limit_one_minus_cos", 0, 0, 0, "at", a, s, "expr", value) and a == 0 / 1 and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and limit_node(e, bb, "var", x, 0 / 1, 0, 0) and limit_node(e, value, "const", "", 0 / 1, 0, 0) and limit_node(e, aa, "sub", "", 0 / 1, cc, dd) and limit_node(e, cc, "const", "", 1 / 1, 0, 0) and limit_node(e, dd, "cos", "", 0 / 1, en, 0) and calc.expressions::equivalent(e, en, bb);
    then limit_method_match(p, i);
}

rule LimitValuesEquivalent(p: Derivation, e: calc.expressions::Expr, x: Text, vj: Integer, vkkid: Integer) strict {
    label ru unofficial "структурно равные конечные значения (§4 DECISION-0197)";
    when context_of(p, e, x) and calc.expressions::equivalent(e, vj, vkkid);
    then limit_same_value(e, "expr", vj, "expr", vkkid);
}

rule LimitValuesplus_inf(p: Derivation, e: calc.expressions::Expr, x: Text) strict {
    label ru unofficial "совпадающие знаки бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x);
    then limit_same_value(e, "plus_inf", 0, "plus_inf", 0);
}

rule LimitValuesminus_inf(p: Derivation, e: calc.expressions::Expr, x: Text) strict {
    label ru unofficial "совпадающие знаки бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x);
    then limit_same_value(e, "minus_inf", 0, "minus_inf", 0);
}

rule LimitConstantsDifferent(p: Derivation, e: calc.expressions::Expr, x: Text, av: Rational, bv: Rational, vj: Integer, vkkid: Integer) strict {
    label ru unofficial "разные рациональные константы доказывают несовпадение (§4 DECISION-0197)";
    when context_of(p, e, x) and limit_node(e, vj, "const", "", av, 0, 0) and limit_node(e, vkkid, "const", "", bv, 0, 0) and av != bv;
    then limit_different_value(e, "expr", vj, "expr", vkkid);
}

rule LimitKindsDifferentplus_inf(p: Derivation, e: calc.expressions::Expr, x: Text) strict {
    label ru unofficial "разные знаки бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x);
    then limit_different_value(e, "plus_inf", 0, "minus_inf", 0);
}

rule LimitKindsDifferentminus_inf(p: Derivation, e: calc.expressions::Expr, x: Text) strict {
    label ru unofficial "разные знаки бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x);
    then limit_different_value(e, "minus_inf", 0, "plus_inf", 0);
}

rule LimitFiniteInfiniteplus_inf0(p: Derivation, e: calc.expressions::Expr, x: Text, vj: Integer) strict {
    label ru unofficial "конечное значение отличается от бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x) and calc.expressions::well_formed(e, vj);
    then limit_different_value(e, "expr", vj, "plus_inf", 0);
}

rule LimitFiniteInfiniteplus_inf1(p: Derivation, e: calc.expressions::Expr, x: Text, vj: Integer) strict {
    label ru unofficial "конечное значение отличается от бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x) and calc.expressions::well_formed(e, vj);
    then limit_different_value(e, "plus_inf", 0, "expr", vj);
}

rule LimitFiniteInfiniteminus_inf0(p: Derivation, e: calc.expressions::Expr, x: Text, vj: Integer) strict {
    label ru unofficial "конечное значение отличается от бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x) and calc.expressions::well_formed(e, vj);
    then limit_different_value(e, "expr", vj, "minus_inf", 0);
}

rule LimitFiniteInfiniteminus_inf1(p: Derivation, e: calc.expressions::Expr, x: Text, vj: Integer) strict {
    label ru unofficial "конечное значение отличается от бесконечности (§4 DECISION-0197)";
    when context_of(p, e, x) and calc.expressions::well_formed(e, vj);
    then limit_different_value(e, "minus_inf", 0, "expr", vj);
}

rule Checkone_sided_agree(p: Derivation, e: calc.expressions::Expr, vk: Text, x: Text, vkj: Text, vkk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer) strict {
    label ru unofficial "сравнить левый и правый предел одной функции (§4 DECISION-0197)";
    when unique_limit(p, i, f, "one_sided_agree", j, k, 0, "at", a, "both", vk, value) and context_of(p, e, x) and monotone(limit_result(p, j, gj, "at", a, "left", vkj, vj)) and monotone(limit_result(p, k, gk, "at", a, "right", vkk, vkkid)) and j > 0 and j < i and k > 0 and k < i and calc.expressions::equivalent(e, f, gj) and calc.expressions::equivalent(e, f, gk) and limit_same_value(e, vkj, vj, vkk, vkkid) and limit_same_value(e, vk, value, vkj, vj);
    then limit_method_match(p, i);
}

rule Checkone_sided_differ(p: Derivation, e: calc.expressions::Expr, vk: Text, x: Text, vkj: Text, vkk: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer) strict {
    label ru unofficial "сравнить левый и правый предел одной функции (§4 DECISION-0197)";
    when unique_limit(p, i, f, "one_sided_differ", j, k, 0, "at", a, "both", vk, value) and context_of(p, e, x) and monotone(limit_result(p, j, gj, "at", a, "left", vkj, vj)) and monotone(limit_result(p, k, gk, "at", a, "right", vkk, vkkid)) and j > 0 and j < i and k > 0 and k < i and calc.expressions::equivalent(e, f, gj) and calc.expressions::equivalent(e, f, gk) and vk == "dne" and value == 0 and limit_different_value(e, vkj, vj, vkk, vkkid);
    then limit_method_match(p, i);
}

rule LimitsPolynomialVariable(p: Derivation, e: calc.expressions::Expr, m: Text, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, l: Integer, value: Integer) strict {
    label ru unofficial "переиспользовать мост выражение → многочлен (§4 DECISION-0197)";
    when limit_line(p, i, f, m, j, k, l, ap, a, s, vk, value) and context_of(p, e, x);
    then calc.polynomials_q::polynomial_variable(e, x);
}

rule LimitAskPolynomialValue(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "запрос Горнера для многочлена (§4 DECISION-0197)";
    when unique_limit(p, i, f, "direct_substitution", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and calc.polynomials_q::polynomial_of(e, f, x, pp);
    then calc.polynomials_q::evaluation_request(pp, a);
}

rule LimitPolynomialValue(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, v: Rational, i: Integer, f: Integer, value: Integer, pp: calc.polynomials_q::Poly) strict {
    label ru unofficial "прямая подстановка: значение многочлена (§4 DECISION-0197)";
    when unique_limit(p, i, f, "direct_substitution", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and calc.polynomials_q::polynomial_of(e, f, x, pp) and calc.polynomials_q::poly_value(pp, a, v) and limit_node(e, value, "const", "", v, 0, 0);
    then limit_method_match(p, i);
}

rule LimitAskRationalValue(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "явный запрос значения дроби (§4 DECISION-0197)";
    when unique_limit(p, i, f, "direct_substitution", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd);
    then calc.polynomials_q::rational_value_request(pn, pd, a);
}

rule LimitRationalValue(p: Derivation, e: calc.expressions::Expr, s: Text, x: Text, a: Rational, v: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "прямая подстановка: значение дроби (§4 DECISION-0197)";
    when unique_limit(p, i, f, "direct_substitution", 0, 0, 0, "at", a, s, "expr", value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd) and calc.polynomials_q::rational_value(pn, pd, a, v) and limit_node(e, value, "const", "", v, 0, 0);
    then limit_method_match(p, i);
}

rule LimitAskInfinity(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "явный запрос предела дроби по степеням (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_at_infinity_rational", 0, 0, 0, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd);
    then calc.polynomials_q::infinity_limit_request(pn, pd, ap);
}

rule LimitInfinityFinite(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, v: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "конечный ответ вычислителя предела (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_at_infinity_rational", 0, 0, 0, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd) and vk == "expr" and calc.polynomials_q::rational_infinity_limit(pn, pd, ap, "rational", v) and limit_node(e, value, "const", "", v, 0, 0);
    then limit_method_match(p, i);
}

rule LimitInfinityplus_inf(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "бесконечный ответ вычислителя предела (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_at_infinity_rational", 0, 0, 0, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd) and vk == "plus_inf" and value == 0 and calc.polynomials_q::rational_infinity_limit(pn, pd, ap, "plus_inf", 0 / 1);
    then limit_method_match(p, i);
}

rule LimitInfinityminus_inf(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, vk: Text, x: Text, a: Rational, i: Integer, f: Integer, value: Integer, aa: Integer, bb: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly) strict {
    label ru unofficial "бесконечный ответ вычислителя предела (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_at_infinity_rational", 0, 0, 0, ap, a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd) and vk == "minus_inf" and value == 0 and calc.polynomials_q::rational_infinity_limit(pn, pd, ap, "minus_inf", 0 / 1);
    then limit_method_match(p, i);
}

rule LimitFactorCancel(p: Derivation, e: calc.expressions::Expr, s: Text, vk: Text, x: Text, vkj: Text, a: Rational, i: Integer, f: Integer, j: Integer, value: Integer, gj: Integer, vj: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer, pn: calc.polynomials_q::Poly, pd: calc.polynomials_q::Poly, pp: calc.polynomials_q::Poly, pq: calc.polynomials_q::Poly, qn: calc.polynomials_q::Poly, qd: calc.polynomials_q::Poly, cancel: calc.polynomials_q::Cancellation) strict {
    label ru unofficial "оба остатка нулевые, основание — предел сокращённой дроби (§4 DECISION-0197)";
    when unique_limit(p, i, f, "factor_and_cancel", j, 0, 0, "at", a, s, vk, value) and context_of(p, e, x) and limit_node(e, f, "div", "", 0 / 1, aa, bb) and calc.polynomials_q::polynomial_of(e, aa, x, pn) and calc.polynomials_q::polynomial_of(e, bb, x, pd) and limit_cancellation(p, i, cancel) and calc.polynomials_q::cancellation_request(cancel, pn, pd, a) and calc.polynomials_q::cancelled_ratio(cancel, qn, qd) and monotone(limit_pair(p, i, j, gj, vkj, vj)) and limit_node(e, gj, "div", "", 0 / 1, cc, dd) and calc.polynomials_q::polynomial_of(e, cc, x, pp) and calc.polynomials_q::polynomial_of(e, dd, x, pq) and calc.polynomials_q::polys_equal(qn, pp) and calc.polynomials_q::polys_equal(qd, pq) and limit_same_value(e, vk, value, vkj, vj);
    then limit_method_match(p, i);
}

rule DerivativeOriginconstant_rule(p: Derivation, e: calc.expressions::Expr, x: Text, i: Integer, f: Integer, j: Integer, gj: Integer) strict {
    label ru unofficial "происхождение проверенной производной от исходной функции (§4 DECISION-0197)";
    when unique_line(p, i, f, "constant_rule", j, 0, 0, 0) and unique_line(p, j, gj, "given", 0, 0, 0, 0) and monotone(checked(p, i, f)) and monotone(checked(p, j, gj)) and context_of(p, e, x) and calc.expressions::well_formed(e, f) and calc.expressions::well_formed(e, gj) and j > 0 and j < i;
    then derivative_origin(p, i, f, gj);
}

rule DerivativeOriginpower_rule(p: Derivation, e: calc.expressions::Expr, x: Text, i: Integer, f: Integer, j: Integer, gj: Integer) strict {
