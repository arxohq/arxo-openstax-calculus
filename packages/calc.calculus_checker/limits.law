}

rule Checklimit_sum(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "закон пределов проверяет структуру функции и результата (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_sum", j, k, 0, ap, a, s, "expr", value) and context_of(p, e, x) and monotone(limit_operand(p, i, j, gj, vj)) and monotone(limit_operand(p, i, k, gk, vkkid)) and limit_node(e, f, "add", "", 0 / 1, aa, bb) and calc.expressions::equivalent(e, aa, gj) and calc.expressions::equivalent(e, bb, gk) and limit_node(e, value, "add", "", 0 / 1, cc, dd) and calc.expressions::equivalent(e, cc, vj) and calc.expressions::equivalent(e, dd, vkkid);
    then limit_method_match(p, i);
}

rule Checklimit_difference(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
    label ru unofficial "закон пределов проверяет структуру функции и результата (§4 DECISION-0197)";
    when unique_limit(p, i, f, "limit_difference", j, k, 0, ap, a, s, "expr", value) and context_of(p, e, x) and monotone(limit_operand(p, i, j, gj, vj)) and monotone(limit_operand(p, i, k, gk, vkkid)) and limit_node(e, f, "sub", "", 0 / 1, aa, bb) and calc.expressions::equivalent(e, aa, gj) and calc.expressions::equivalent(e, bb, gk) and limit_node(e, value, "sub", "", 0 / 1, cc, dd) and calc.expressions::equivalent(e, cc, vj) and calc.expressions::equivalent(e, dd, vkkid);
    then limit_method_match(p, i);
}

rule Checklimit_product(p: Derivation, e: calc.expressions::Expr, ap: Text, s: Text, x: Text, a: Rational, i: Integer, f: Integer, j: Integer, k: Integer, value: Integer, gj: Integer, gk: Integer, vj: Integer, vkkid: Integer, aa: Integer, bb: Integer, cc: Integer, dd: Integer) strict {
